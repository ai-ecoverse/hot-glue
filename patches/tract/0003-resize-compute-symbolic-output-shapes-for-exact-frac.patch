From 2cdb7e79fda8f7e009589d444bc723c21c487a30 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 17 Aug 2026 07:10:16 +0000
Subject: [PATCH 3/6] resize: compute symbolic output shapes for exact
 fractional scales

A Resize with a fractional scale on a symbolic dim bailed out of
shape computation. Approximate the f32 scale as a small rational by
continued fractions, accepting only exact f32 round-trips, and let
the dim algebra do exact arithmetic: 600*S at scale 1/300 is 2*S.
Concrete dims keep the existing floor(i*s) behavior; the rational
path is only the symbolic fallback.
---
 core/src/ops/nn/resize.rs | 32 ++++++++++++++++++++++++++++++++
 onnx-opl/src/resize.rs    | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+)

diff --git a/core/src/ops/nn/resize.rs b/core/src/ops/nn/resize.rs
index cb5d2c8..5b0355a 100644
--- a/core/src/ops/nn/resize.rs
+++ b/core/src/ops/nn/resize.rs
@@ -310,6 +310,36 @@ pub struct Resize {
     pub optional_sizes_input: Option<usize>,
 }
 
+
+/// Approximate a positive f32 scale as a small rational p/q by
+/// continued fractions, accepting only exact f32 round-trips. This
+/// lets symbolic dims resize exactly: 600*S at scale 1/300 is 2*S.
+fn scale_as_rational(s: f32) -> Option<(usize, usize)> {
+    if !(s.is_finite() && s > 0.0) {
+        return None;
+    }
+    let (mut p0, mut q0, mut p1, mut q1) = (0u64, 1u64, 1u64, 0u64);
+    let mut x = s as f64;
+    for _ in 0..32 {
+        let a = x.floor() as u64;
+        let p2 = a.checked_mul(p1)?.checked_add(p0)?;
+        let q2 = a.checked_mul(q1)?.checked_add(q0)?;
+        if q2 > 10_000 {
+            return None;
+        }
+        (p0, q0, p1, q1) = (p1, q1, p2, q2);
+        if q1 != 0 && p1 as f32 / q1 as f32 == s {
+            return Some((p1 as usize, q1 as usize));
+        }
+        let frac = x - x.floor();
+        if frac < 1e-12 {
+            return None;
+        }
+        x = 1.0 / frac;
+    }
+    None
+}
+
 impl Resize {
     pub fn compute_output_shape<D: DimLike>(
         &self,
@@ -329,6 +359,8 @@ impl Resize {
                     shape.push(i.clone() * (*s as usize));
                 } else if let Ok(i) = i.to_usize() {
                     shape.push(((i as f32 * s) as usize).into());
+                } else if let Some((p, q)) = scale_as_rational(*s) {
+                    shape.push(i.clone() * p / q);
                 } else {
                     bail!(
                         "Can not compute output shape. inputs are {input_shape:?} and scale {scale:?}"
