From c2093ae89d5b82c7caa86cf8afb4401692e90ddd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 17 Aug 2026 07:10:16 +0000
Subject: [PATCH 2/6] hir: keep Range's promise of i64 output for symbolic
 bounds

The inference rules declare an i64 output when the bound supertype
is TDim, but wire() emitted the raw TDim-typed range, making the
expansion rewiring fail with an output datum type mismatch. Cast
back to i64 as promised. Also assert the freshly minted length
symbol non-negative: a range length is non-negative by construction,
and saying so lets the dim algebra simplify expressions like
(1+2*range)/2 to range, which shape unification downstream needs.
---
 hir/src/ops/array/range.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/hir/src/ops/array/range.rs b/hir/src/ops/array/range.rs
index f7a5391..898bef3 100644
--- a/hir/src/ops/array/range.rs
+++ b/hir/src/ops/array/range.rs
@@ -60,6 +60,18 @@ impl Expansion for Range {
         .context("No supertype for inputs")?;
         let inputs = wire_cast(prefix, model, inputs, dt)?;
         let len = model.symbols.new_with_prefix("range");
-        model.wire_node(prefix, tract_core::ops::array::Range::new(len.into()), &inputs)
+        // a range length is non-negative by construction; saying so lets
+        // the dim algebra simplify expressions like (1+2*range)/2 to range
+        model.symbols.add_assertion(format!("{len} >= 0"))?;
+        let wire = model.wire_node(prefix, tract_core::ops::array::Range::new(len.into()), &inputs)?;
+        // the rules promise i64 when the supertype is TDim — keep the promise
+        if dt.is_tdim() {
+            return model.wire_node(
+                format!("{prefix}.cast_to_i64"),
+                tract_core::ops::cast::cast(i64::datum_type()),
+                &wire,
+            );
+        }
+        Ok(wire)
     }
 }
