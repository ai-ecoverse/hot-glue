;; perl-driver.hma — Perl 5 under a pure wasm runtime, driven by Hot
;; Glue. The supervisor owns no memory: it imports zeroperl's, and
;; every buffer it needs it politely mallocs from Perl's own heap.
;; stdin carries the script path; stdout is Perl's. The runtime
;; auto-initializes the preloaded reactor, and the imported memory is
;; re-exported so WASI will speak to a memory-less guest. Perl wants
;; a /dev/null; mount it one.
;;
;;   echo -n examples/narration.pl | \
;;     wasmtime --dir . --dir some-empty-dir::/dev \
;;       --preload env=envstub.wasm \
;;       --preload zeroperl=node_modules/@6over3/zeroperl-ts/dist/esm/zeroperl.wasm \
;;       perl-driver.wasm

(use prelude.hma)

(module
  (import "zeroperl" "memory" (memory 2))
  (import "zeroperl" "malloc" (func $malloc (param i32) (result i32)))
  (import "zeroperl" "zeroperl_init" (func $perl-init (result i32)))
  (import "zeroperl" "zeroperl_run_file" (func $perl-run (param i32 i32 i32) (result i32)))
  (import "zeroperl" "zeroperl_flush" (func $perl-flush (result i32)))
  (import "wasi_snapshot_preview1" "fd_read"
    (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (export "memory" (memory 0))

  (func (export "_start")
    ($let (($buf (call $malloc (i32.const 4112))) ($n (i32.const 0)) ($rc (i32.const 0)))
      ;; iovec at buf, nread at buf+8, the path at buf+16
      (i32.store (local.get $buf) (i32.add (local.get $buf) (i32.const 16)))
      (i32.store (i32.add (local.get $buf) (i32.const 4)) (i32.const 4095))
      ($when (call $fd_read (i32.const 0) (local.get $buf) (i32.const 1)
                            (i32.add (local.get $buf) (i32.const 8)))
        (call $exit (i32.const 3)))
      (local.set $n (i32.load (i32.add (local.get $buf) (i32.const 8))))
      ;; trim a trailing newline, terminate the C string
      ($when ($and (i32.gt_u (local.get $n) (i32.const 0))
                   (i32.eq (i32.load8_u (i32.add (i32.add (local.get $buf) (i32.const 16))
                                                 (i32.sub (local.get $n) (i32.const 1))))
                           (i32.const 10)))
        (local.set $n (i32.sub (local.get $n) (i32.const 1))))
      (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 16)) (local.get $n)) (i32.const 0))
      ($when (call $perl-init) (call $exit (i32.const 4)))
      (local.set $rc (call $perl-run (i32.add (local.get $buf) (i32.const 16))
                                     (i32.const 0) (i32.const 0)))
      (drop (call $perl-flush))
      ($when (local.get $rc) (call $exit (local.get $rc))))))
