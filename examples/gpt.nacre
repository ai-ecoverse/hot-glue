;; gpt.nacre — a language model, close to the metal.
;;
;; The nanochat dialect in miniature: byte-level vocabulary, RMSNorm,
;; rotary embeddings, ReLU-squared MLP, no biases, tied head. Chosen
;; not only for taste — these are the transformer operations that
;; reduce to multiplies, one square root, and an exp, which is
;; exactly the arithmetic a self-assembled Lisp likes to write.
;;
;; stdin:  [.npt weights][u32 prompt-len][prompt][u32 gen][f32 temp][u32 seed]
;; stdout: generated bytes, streamed token by token
;;
;;   python3 scripts/train-oyster.py
;;   npx tsx src/nacre/cli.ts src/nacre/clj.nacre examples/gpt.nacre > gpt.wat
;;   cat examples/oyster.npt prompt.bin | wasmtime gpt.wat
;;
;; Slots: 16 wte, 20 cos, 24 sin, 28 layers, 32 gf, 36 kv, 40 x,
;; 44 xn, 48 q, 52 k, 56 v, 60 a, 64 h1, 68 logits, 72 V, 76 d,
;; 80 L, 84 H, 88 ctx, 92 hd/2, 96 pptr, 100 plen, 104 gen,
;; 108 temp(f32), 112 seed, 116 hd, 124 scores, 128 scale(f32),
;; 132 layer-stride, 136 tmp, 140.. layer offsets.

(module
  (type $q-v (func))
  (type $q-i (func (result i32)))
  (type $q-i-v (func (param i32)))
  (type $q-ii-v (func (param i32 i32)))
  (type $q-iiii-v (func (param i32 i32 i32 i32)))
  (type $q-5i-v (func (param i32 i32 i32 i32 i32)))
  (type $q-iiii-i (func (param i32 i32 i32 i32) (result i32)))
  (type $q-f-f (func (param f32) (result f32)))
  (type $q-iii-f (func (param i32 i32 i32) (result f32)))
  (type $q-f (func (result f32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (type $q-iiii-i)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (type $q-iiii-i)))
  (memory (export "memory") 16)

  (func $read-all (type $q-i) (result i32)
    (let [$n 0]
      (block $done
        (loop $more
          (while (> (+ (+ 65536 (local.get $n)) 65536) (* (memory.size) 65536))
            (drop (memory.grow (num 16))))
          (i32.store (i32.const 0) (+ 65536 (local.get $n)))
          (i32.store (i32.const 4) (num 65536))
          (drop (call $fd_read (num 0) (num 0) (num 1) (num 8)))
          (br_if $done (zero? (i32.load (i32.const 8))))
          (local.set $n (+ (local.get $n) (i32.load (i32.const 8))))
          (br $more)))
      (local.get $n)))

  (func $put1 (type $q-i-v) (param $b i32)
    (i32.store8 (i32.const 12) (local.get $b))
    (i32.store (i32.const 0) (num 12))
    (i32.store (i32.const 4) (num 1))
    (drop (call $fd_write (num 1) (num 0) (num 1) (num 8))))

  (func $putn (type $q-ii-v) (param $p i32) (param $n i32)
    (while (> (local.get $n) (num 0))
      (i32.store (i32.const 0) (local.get $p))
      (i32.store (i32.const 4) (local.get $n))
      (i32.store (i32.const 8) (num 0))
      (when (call $fd_write (num 1) (num 0) (num 1) (num 8)) (return))
      (when (zero? (i32.load (i32.const 8))) (return))
      (local.set $p (+ (local.get $p) (i32.load (i32.const 8))))
      (local.set $n (- (local.get $n) (i32.load (i32.const 8))))))

  (func $ensure (type $q-i-v) (param $end i32)
    (while (> (+ (local.get $end) 65536) (* (memory.size) 65536))
      (drop (memory.grow (num 16)))))

  ;; exp by range reduction: x = k ln2 + r, e^x = 2^k poly(r)
  (func $exp (type $q-f-f) (param $x f32) (result f32)
    (local $kf f32)
    (local $r f32)
    (local $p f32)
    (let [$k 0]
      (local.set $kf (f32.nearest (f32.mul (local.get $x) (f32.const 1.4426950408889634))))
      (local.set $k (i32.trunc_f32_s (local.get $kf)))
      (when (> (local.get $k) 126) (local.set $k (num 126)) (local.set $kf (f32.convert_i32_s (local.get $k))))
      (when (< (local.get $k) -126) (local.set $k (num -126)) (local.set $kf (f32.convert_i32_s (local.get $k))))
      (local.set $r (f32.sub (local.get $x) (f32.mul (local.get $kf) (f32.const 0.6931471805599453))))
      (local.set $p (f32.add (f32.const 1)
        (f32.mul (local.get $r) (f32.add (f32.const 1)
          (f32.mul (f32.mul (local.get $r) (f32.const 0.5)) (f32.add (f32.const 1)
            (f32.mul (f32.mul (local.get $r) (f32.const 0.33333333)) (f32.add (f32.const 1)
              (f32.mul (f32.mul (local.get $r) (f32.const 0.25)) (f32.add (f32.const 1)
                (f32.mul (local.get $r) (f32.const 0.2))))))))))))
      (f32.mul (local.get $p)
        (f32.reinterpret_i32 (bit-shift-left (+ (local.get $k) 127) 23)))))

  ;; y[0..o) = x[0..i) times W[i][o], W input-major
  (func $matvec (type $q-5i-v) (param $x i32) (param $w i32) (param $y i32) (param $ni i32) (param $no i32)
    (local $xi f32)
    (let [$i 0 $o 0 $wr 0]
      (while (< (local.get $o) (local.get $no))
        (f32.store (+ (local.get $y) (* 4 (local.get $o))) (f32.const 0))
        (local.set $o (inc (local.get $o))))
      (while (< (local.get $i) (local.get $ni))
        (local.set $xi (f32.load (+ (local.get $x) (* 4 (local.get $i)))))
        (local.set $wr (+ (local.get $w) (* (* 4 (local.get $no)) (local.get $i))))
        (local.set $o (num 0))
        (while (< (local.get $o) (local.get $no))
          (f32.store (+ (local.get $y) (* 4 (local.get $o)))
            (f32.add (f32.load (+ (local.get $y) (* 4 (local.get $o))))
                     (f32.mul (local.get $xi) (f32.load (+ (local.get $wr) (* 4 (local.get $o)))))))
          (local.set $o (inc (local.get $o))))
        (local.set $i (inc (local.get $i))))))

  ;; dst = src normalized by root mean square, scaled by g
  (func $rms (type $q-iiii-v) (param $src i32) (param $g i32) (param $dst i32) (param $n i32)
    (local $ms f32)
    (local $sc f32)
    (local $t f32)
    (let [$i 0]
      (local.set $ms (f32.const 0))
      (while (< (local.get $i) (local.get $n))
        (local.set $t (f32.load (+ (local.get $src) (* 4 (local.get $i)))))
        (local.set $ms (f32.add (local.get $ms) (f32.mul (local.get $t) (local.get $t))))
        (local.set $i (inc (local.get $i))))
      (local.set $sc (f32.div (f32.const 1)
        (f32.sqrt (f32.add (f32.div (local.get $ms) (f32.convert_i32_s (local.get $n)))
                           (f32.const 0.00001)))))
      (local.set $i (num 0))
      (while (< (local.get $i) (local.get $n))
        (f32.store (+ (local.get $dst) (* 4 (local.get $i)))
          (f32.mul (f32.mul (f32.load (+ (local.get $src) (* 4 (local.get $i)))) (local.get $sc))
                   (f32.load (+ (local.get $g) (* 4 (local.get $i))))))
        (local.set $i (inc (local.get $i))))
      (drop (local.get $t))))

  ;; rotary: rotate pairs within each head by the position's angle
  (func $rot (type $q-ii-v) (param $p i32) (param $pos i32)
    (local $a f32)
    (local $b f32)
    (local $c f32)
    (local $s f32)
    (let [$h 0 $j 0 $base 0 $tb 0]
      (local.set $tb (+ (i32.load (i32.const 20)) (* (* 4 (i32.load (i32.const 92))) (local.get $pos))))
      (while (< (local.get $h) (i32.load (i32.const 84)))
        (local.set $base (+ (local.get $p) (* (* 4 (i32.load (i32.const 116))) (local.get $h))))
        (local.set $j (num 0))
        (while (< (local.get $j) (i32.load (i32.const 92)))
          (local.set $c (f32.load (+ (local.get $tb) (* 4 (local.get $j)))))
          (local.set $s (f32.load (+ (+ (local.get $tb) (* 4 (local.get $j)))
            (- (i32.load (i32.const 24)) (i32.load (i32.const 20))))))
          (local.set $a (f32.load (+ (local.get $base) (* 8 (local.get $j)))))
          (local.set $b (f32.load (+ (+ (local.get $base) (* 8 (local.get $j))) 4)))
          (f32.store (+ (local.get $base) (* 8 (local.get $j)))
            (f32.sub (f32.mul (local.get $a) (local.get $c)) (f32.mul (local.get $b) (local.get $s))))
          (f32.store (+ (+ (local.get $base) (* 8 (local.get $j))) 4)
            (f32.add (f32.mul (local.get $a) (local.get $s)) (f32.mul (local.get $b) (local.get $c))))
          (local.set $j (inc (local.get $j))))
        (local.set $h (inc (local.get $h))))))

  (func $dot (type $q-iii-f) (param $a i32) (param $b i32) (param $n i32) (result f32)
    (local $acc f32)
    (let [$i 0]
      (local.set $acc (f32.const 0))
      (while (< (local.get $i) (local.get $n))
        (local.set $acc (f32.add (local.get $acc)
          (f32.mul (f32.load (+ (local.get $a) (* 4 (local.get $i))))
                   (f32.load (+ (local.get $b) (* 4 (local.get $i)))))))
        (local.set $i (inc (local.get $i))))
      (local.get $acc)))

  ;; one attention block at layer l, position t; x updated in place
  (func $attn (type $q-ii-v) (param $l i32) (param $t i32)
    (local $m f32)
    (local $sum f32)
    (local $e f32)
    (local $wv f32)
    (let [$d (i32.load (i32.const 76)) $hd (i32.load (i32.const 116))
          $lw 0 $kc 0 $vc 0 $h 0 $s 0 $i 0 $qh 0 $sc (i32.load (i32.const 124))]
      (local.set $lw (+ (i32.load (i32.const 28)) (* (i32.load (i32.const 132)) (local.get $l))))
      (call $rms (i32.load (i32.const 40)) (+ (local.get $lw) (i32.load (i32.const 140)))
                 (i32.load (i32.const 44)) (local.get $d))
      (call $matvec (i32.load (i32.const 44)) (+ (local.get $lw) (i32.load (i32.const 144)))
                    (i32.load (i32.const 48)) (local.get $d) (local.get $d))
      (call $matvec (i32.load (i32.const 44)) (+ (local.get $lw) (i32.load (i32.const 148)))
                    (i32.load (i32.const 52)) (local.get $d) (local.get $d))
      (call $matvec (i32.load (i32.const 44)) (+ (local.get $lw) (i32.load (i32.const 152)))
                    (i32.load (i32.const 56)) (local.get $d) (local.get $d))
      (call $rot (i32.load (i32.const 48)) (local.get $t))
      (call $rot (i32.load (i32.const 52)) (local.get $t))
      ;; cache k and v at position t
      (local.set $kc (+ (i32.load (i32.const 36))
        (* (* 8 (* 4 (i32.load (i32.const 88)))) (* (local.get $l) (quot (local.get $d) 4)))))
      (local.set $vc (+ (local.get $kc) (* (* 4 (local.get $d)) (i32.load (i32.const 88)))))
      (let [$dst (+ (local.get $kc) (* (* 4 (local.get $d)) (local.get $t)))]
        (memory.copy (local.get $dst) (i32.load (i32.const 52)) (* 4 (local.get $d))))
      (let [$dst2 (+ (local.get $vc) (* (* 4 (local.get $d)) (local.get $t)))]
        (memory.copy (local.get $dst2) (i32.load (i32.const 56)) (* 4 (local.get $d))))
      ;; per head: scores, softmax, weighted sum of cached v into a
      (while (< (local.get $h) (i32.load (i32.const 84)))
        (local.set $qh (+ (i32.load (i32.const 48)) (* (* 4 (local.get $hd)) (local.get $h))))
        (local.set $m (f32.const -1000000))
        (local.set $s (num 0))
        (while (<= (local.get $s) (local.get $t))
          (local.set $e (f32.mul (f32.load (i32.const 128))
            (call $dot (local.get $qh)
              (+ (+ (local.get $kc) (* (* 4 (local.get $d)) (local.get $s)))
                 (* (* 4 (local.get $hd)) (local.get $h)))
              (local.get $hd))))
          (f32.store (+ (local.get $sc) (* 4 (local.get $s))) (local.get $e))
          (when (f32.gt (local.get $e) (local.get $m)) (local.set $m (local.get $e)))
          (local.set $s (inc (local.get $s))))
        (local.set $sum (f32.const 0))
        (local.set $s (num 0))
        (while (<= (local.get $s) (local.get $t))
          (local.set $e (call $exp (f32.sub (f32.load (+ (local.get $sc) (* 4 (local.get $s)))) (local.get $m))))
          (f32.store (+ (local.get $sc) (* 4 (local.get $s))) (local.get $e))
          (local.set $sum (f32.add (local.get $sum) (local.get $e)))
          (local.set $s (inc (local.get $s))))
        (local.set $i (num 0))
        (while (< (local.get $i) (local.get $hd))
          (local.set $wv (f32.const 0))
          (local.set $s (num 0))
          (while (<= (local.get $s) (local.get $t))
            (local.set $wv (f32.add (local.get $wv)
              (f32.mul (f32.load (+ (local.get $sc) (* 4 (local.get $s))))
                (f32.load (+ (+ (+ (local.get $vc) (* (* 4 (local.get $d)) (local.get $s)))
                               (* (* 4 (local.get $hd)) (local.get $h)))
                            (* 4 (local.get $i)))))))
            (local.set $s (inc (local.get $s))))
          (f32.store (+ (+ (i32.load (i32.const 60)) (* (* 4 (local.get $hd)) (local.get $h)))
                       (* 4 (local.get $i)))
            (f32.div (local.get $wv) (local.get $sum)))
          (local.set $i (inc (local.get $i))))
        (local.set $h (inc (local.get $h))))
      ;; project and add the residual
      (call $matvec (i32.load (i32.const 60)) (+ (local.get $lw) (i32.load (i32.const 156)))
                    (i32.load (i32.const 136)) (local.get $d) (local.get $d))
      (local.set $i (num 0))
      (while (< (local.get $i) (local.get $d))
        (f32.store (+ (i32.load (i32.const 40)) (* 4 (local.get $i)))
          (f32.add (f32.load (+ (i32.load (i32.const 40)) (* 4 (local.get $i))))
                   (f32.load (+ (i32.load (i32.const 136)) (* 4 (local.get $i))))))
        (local.set $i (inc (local.get $i))))))

  ;; relu-squared mlp at layer l; x updated in place
  (func $mlp (type $q-i-v) (param $l i32)
    (local $t f32)
    (let [$d (i32.load (i32.const 76)) $d4 (* 4 (i32.load (i32.const 76)))
          $lw 0 $i 0]
      (local.set $lw (+ (i32.load (i32.const 28)) (* (i32.load (i32.const 132)) (local.get $l))))
      (call $rms (i32.load (i32.const 40)) (+ (local.get $lw) (i32.load (i32.const 160)))
                 (i32.load (i32.const 44)) (local.get $d))
      (call $matvec (i32.load (i32.const 44)) (+ (local.get $lw) (i32.load (i32.const 164)))
                    (i32.load (i32.const 64)) (local.get $d) (local.get $d4))
      (while (< (local.get $i) (local.get $d4))
        (local.set $t (f32.load (+ (i32.load (i32.const 64)) (* 4 (local.get $i)))))
        (when (f32.lt (local.get $t) (f32.const 0)) (local.set $t (f32.const 0)))
        (f32.store (+ (i32.load (i32.const 64)) (* 4 (local.get $i)))
          (f32.mul (local.get $t) (local.get $t)))
        (local.set $i (inc (local.get $i))))
      (call $matvec (i32.load (i32.const 64)) (+ (local.get $lw) (i32.load (i32.const 168)))
                    (i32.load (i32.const 136)) (local.get $d4) (local.get $d))
      (local.set $i (num 0))
      (while (< (local.get $i) (local.get $d))
        (f32.store (+ (i32.load (i32.const 40)) (* 4 (local.get $i)))
          (f32.add (f32.load (+ (i32.load (i32.const 40)) (* 4 (local.get $i))))
                   (f32.load (+ (i32.load (i32.const 136)) (* 4 (local.get $i))))))
        (local.set $i (inc (local.get $i))))))

  ;; one full forward step: token at position, logits left at slot 68
  (func $forward (type $q-ii-v) (param $tok i32) (param $pos i32)
    (let [$d (i32.load (i32.const 76)) $l 0 $v 0]
      (memory.copy (i32.load (i32.const 40))
        (+ (i32.load (i32.const 16)) (* (* 4 (local.get $d)) (local.get $tok)))
        (* 4 (local.get $d)))
      (while (< (local.get $l) (i32.load (i32.const 80)))
        (call $attn (local.get $l) (local.get $pos))
        (call $mlp (local.get $l))
        (local.set $l (inc (local.get $l))))
      (call $rms (i32.load (i32.const 40)) (i32.load (i32.const 32))
                 (i32.load (i32.const 44)) (local.get $d))
      (while (< (local.get $v) (i32.load (i32.const 72)))
        (f32.store (+ (i32.load (i32.const 68)) (* 4 (local.get $v)))
          (call $dot (i32.load (i32.const 44))
                     (+ (i32.load (i32.const 16)) (* (* 4 (local.get $d)) (local.get $v)))
                     (local.get $d)))
        (local.set $v (inc (local.get $v))))))

  (func $rand (type $q-f) (result f32)
    (let [$s (i32.load (i32.const 112))]
      (local.set $s (bit-xor (local.get $s) (bit-shift-left (local.get $s) 13)))
      (local.set $s (bit-xor (local.get $s) (unsigned-bit-shift-right (local.get $s) 17)))
      (local.set $s (bit-xor (local.get $s) (bit-shift-left (local.get $s) 5)))
      (i32.store (i32.const 112) (local.get $s))
      (f32.mul (f32.convert_i32_u (local.get $s)) (f32.const 2.3283064e-10))))

  ;; temperature zero is argmax; otherwise softmax and roll the dice
  (func $sample (type $q-i) (result i32)
    (local $m f32)
    (local $t f32)
    (local $sum f32)
    (local $r f32)
    (let [$best 0 $v 0 $lg (i32.load (i32.const 68)) $nv (i32.load (i32.const 72))]
      (local.set $m (f32.const -1000000))
      (while (< (local.get $v) (local.get $nv))
        (local.set $t (f32.load (+ (local.get $lg) (* 4 (local.get $v)))))
        (when (f32.gt (local.get $t) (local.get $m))
          (local.set $m (local.get $t))
          (local.set $best (local.get $v)))
        (local.set $v (inc (local.get $v))))
      (when (f32.eq (f32.load (i32.const 108)) (f32.const 0)) (return (local.get $best)))
      (local.set $sum (f32.const 0))
      (local.set $v (num 0))
      (while (< (local.get $v) (local.get $nv))
        (local.set $t (call $exp (f32.div
          (f32.sub (f32.load (+ (local.get $lg) (* 4 (local.get $v)))) (local.get $m))
          (f32.load (i32.const 108)))))
        (f32.store (+ (local.get $lg) (* 4 (local.get $v))) (local.get $t))
        (local.set $sum (f32.add (local.get $sum) (local.get $t)))
        (local.set $v (inc (local.get $v))))
      (local.set $r (f32.mul (call $rand) (local.get $sum)))
      (local.set $v (num 0))
      (while (< (local.get $v) (local.get $nv))
        (local.set $r (f32.sub (local.get $r) (f32.load (+ (local.get $lg) (* 4 (local.get $v))))))
        (when (f32.le (local.get $r) (f32.const 0)) (return (local.get $v)))
        (local.set $v (inc (local.get $v))))
      (- (local.get $nv) 1)))

  (func (export "_start") (type $q-v)
    (let [$len (call $read-all) $base 65536 $d 0 $hd2 0 $p 0 $end 0
          $i 0 $pos 0 $tok 0 $gen 0]
      ;; header: magic, V, d, L, H, ctx
      (i32.store (i32.const 72) (i32.load (+ (local.get $base) 4)))
      (i32.store (i32.const 76) (i32.load (+ (local.get $base) 8)))
      (i32.store (i32.const 80) (i32.load (+ (local.get $base) 12)))
      (i32.store (i32.const 84) (i32.load (+ (local.get $base) 16)))
      (i32.store (i32.const 88) (i32.load (+ (local.get $base) 20)))
      (local.set $d (i32.load (i32.const 76)))
      (i32.store (i32.const 116) (quot (local.get $d) (i32.load (i32.const 84))))
      (i32.store (i32.const 92) (quot (i32.load (i32.const 116)) 2))
      (local.set $hd2 (i32.load (i32.const 92)))
      (f32.store (i32.const 128)
        (f32.div (f32.const 1) (f32.sqrt (f32.convert_i32_s (i32.load (i32.const 116))))))
      ;; weight pointers, in file order
      (i32.store (i32.const 16) (+ (local.get $base) 24))
      (i32.store (i32.const 20) (+ (i32.load (i32.const 16)) (* (* 4 (local.get $d)) (i32.load (i32.const 72)))))
      (i32.store (i32.const 24) (+ (i32.load (i32.const 20)) (* (* 4 (local.get $hd2)) (i32.load (i32.const 88)))))
      (i32.store (i32.const 28) (+ (i32.load (i32.const 24)) (* (* 4 (local.get $hd2)) (i32.load (i32.const 88)))))
      ;; per-layer offsets: g1, wq, wk, wv, wo, g2, w1, w2
      (i32.store (i32.const 140) (num 0))
      (i32.store (i32.const 144) (* 4 (local.get $d)))
      (i32.store (i32.const 148) (+ (i32.load (i32.const 144)) (* (* 4 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 152) (+ (i32.load (i32.const 148)) (* (* 4 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 156) (+ (i32.load (i32.const 152)) (* (* 4 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 160) (+ (i32.load (i32.const 156)) (* (* 4 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 164) (+ (i32.load (i32.const 160)) (* 4 (local.get $d))))
      (i32.store (i32.const 168) (+ (i32.load (i32.const 164)) (* (* 16 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 132) (+ (i32.load (i32.const 168)) (* (* 16 (local.get $d)) (local.get $d))))
      (i32.store (i32.const 32) (+ (i32.load (i32.const 28)) (* (i32.load (i32.const 132)) (i32.load (i32.const 80)))))
      ;; input tail: prompt, gen count, temperature, seed
      (local.set $p (+ (i32.load (i32.const 32)) (* 4 (local.get $d))))
      (i32.store (i32.const 100) (i32.load (local.get $p)))
      (i32.store (i32.const 96) (+ (local.get $p) 4))
      (local.set $p (+ (+ (local.get $p) 4) (i32.load (i32.const 100))))
      (i32.store (i32.const 104) (i32.load (local.get $p)))
      (f32.store (i32.const 108) (f32.load (+ (local.get $p) 4)))
      (i32.store (i32.const 112) (i32.load (+ (local.get $p) 8)))
      ;; work areas after the input, then the kv cache
      (local.set $end (+ (+ (local.get $base) (local.get $len)) 64))
      (i32.store (i32.const 40) (local.get $end))
      (i32.store (i32.const 44) (+ (local.get $end) (* 4 (local.get $d))))
      (i32.store (i32.const 48) (+ (local.get $end) (* 8 (local.get $d))))
      (i32.store (i32.const 52) (+ (local.get $end) (* 12 (local.get $d))))
      (i32.store (i32.const 56) (+ (local.get $end) (* 16 (local.get $d))))
      (i32.store (i32.const 60) (+ (local.get $end) (* 20 (local.get $d))))
      (i32.store (i32.const 136) (+ (local.get $end) (* 24 (local.get $d))))
      (i32.store (i32.const 64) (+ (local.get $end) (* 28 (local.get $d))))
      (i32.store (i32.const 68) (+ (local.get $end) (* 44 (local.get $d))))
      (i32.store (i32.const 124) (+ (i32.load (i32.const 68)) (* 4 (i32.load (i32.const 72)))))
      (i32.store (i32.const 36) (+ (i32.load (i32.const 124)) (* 4 (i32.load (i32.const 88)))))
      (call $ensure (+ (i32.load (i32.const 36))
        (* (* 8 (* 4 (i32.load (i32.const 88)))) (* (i32.load (i32.const 80)) (quot (local.get $d) 4)))))
      ;; feed the prompt, then speak
      (while (< (local.get $i) (i32.load (i32.const 100)))
        (call $forward (i32.load8_u (+ (i32.load (i32.const 96)) (local.get $i))) (local.get $pos))
        (local.set $pos (inc (local.get $pos)))
        (local.set $i (inc (local.get $i))))
      ;; a negative temperature asks for the raw logits, not speech
      (when (f32.lt (f32.load (i32.const 108)) (f32.const 0))
        (call $putn (i32.load (i32.const 68)) (* 4 (i32.load (i32.const 72))))
        (return))
      (while (and (< (local.get $gen) (i32.load (i32.const 104)))
                  (< (local.get $pos) (i32.load (i32.const 88))))
        (local.set $tok (call $sample))
        (call $put1 (local.get $tok))
        (call $forward (local.get $tok) (local.get $pos))
        (local.set $pos (inc (local.get $pos)))
        (local.set $gen (inc (local.get $gen)))))))
