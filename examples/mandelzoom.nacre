;; mandelzoom.nacre — a Lisp is a video source now.
;;
;; One hundred fifty frames of descent toward (-0.7435, 0.1314),
;; fourteen fractional bits deep, emitted as YUV4MPEG2 — the format
;; ffmpeg drinks straight, no flags, self-describing. Pipe and go:
;;
;;   npx tsx src/nacre/cli.ts src/nacre/clj.nacre examples/mandelzoom.nacre > mandelzoom.wat
;;   wasmtime mandelzoom.wat | ffmpeg -i - mandelzoom.mp4
;;   wasmtime mandelzoom.wat | ffmpeg -i - -f lavfi -i testsrc2=size=256x256:rate=30 \
;;     -filter_complex hstack -t 5 duet.mp4
;;
;; The same module exports frame(n)/render for hosts that would
;; rather hold the framebuffer themselves — the browser canvas, or
;; an ffmpeg frei0r plugin with a wasm runtime inside.

(module
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 16)

  ;; 14-bit fixed point: 1.0 is 16384; escape at |z|^2 > 4.0 = 65536
  (func $fmul (param $a i32) (param $b i32) (result i32)
    (i32.shr_s (i32.mul (local.get $a) (local.get $b)) (i32.const 14)))

  ;; keep z inside the range whose squares fit an i32
  (func $clamp (param $v i32) (result i32)
    ($if (> (local.get $v) 32767)
         32767
         ($if (< (local.get $v) -32768) -32768 (local.get $v))))

  (func $iters (param $cx i32) (param $cy i32) (result i32)
    (let [$zx 0 $zy 0 $i 0 $t 0]
      (while (and (< (local.get $i) 64)
                  (<= (+ (call $fmul (local.get $zx) (local.get $zx))
                         (call $fmul (local.get $zy) (local.get $zy)))
                      65536))
        (local.set $t (call $clamp
          (+ (- (call $fmul (local.get $zx) (local.get $zx))
                (call $fmul (local.get $zy) (local.get $zy)))
             (local.get $cx))))
        (local.set $zy (call $clamp
          (+ (* 2 (call $fmul (local.get $zx) (local.get $zy)))
             (local.get $cy))))
        (local.set $zx (local.get $t))
        (local.set $i (inc (local.get $i))))
      (local.get $i)))

  (func $shade (param $i i32) (param $p i32)
    (if (= (local.get $i) 64)
      (then
        (i32.store8 (local.get $p) (i32.const 0))
        (i32.store8 (+ (local.get $p) 1) (i32.const 0))
        (i32.store8 (+ (local.get $p) 2) (i32.const 0)))
      (else
        (i32.store8 (local.get $p) (- 255 (* 3 (local.get $i))))
        (i32.store8 (+ (local.get $p) 1) (* 4 (local.get $i)))
        (i32.store8 (+ (local.get $p) 2) (+ 96 (* 2 (local.get $i)))))))

  (func (export "width") (result i32) (i32.const 256))
  (func (export "height") (result i32) (i32.const 256))

  ;; render frame n of the zoom into the RGB buffer at 65536
  (func $frame (export "frame") (param $n i32) (result i32)
    (let [$span 57344 $k 0 $x0 0 $y0 0 $st 0 $px 0 $py 0 $p 65536]
      (while (< (local.get $k) (local.get $n))
        (local.set $span (unsigned-bit-shift-right (* (local.get $span) 989) 10))
        (local.set $k (inc (local.get $k))))
      (local.set $st (unsigned-bit-shift-right (local.get $span) 8))
      (local.set $x0 (- -12182 (unsigned-bit-shift-right (local.get $span) 1)))
      (local.set $y0 (- 2153 (unsigned-bit-shift-right (local.get $span) 1)))
      (while (< (local.get $py) 256)
        (local.set $px (num 0))
        (while (< (local.get $px) 256)
          (call $shade
            (call $iters (+ (local.get $x0) (* (local.get $st) (local.get $px)))
                         (+ (local.get $y0) (* (local.get $st) (local.get $py))))
            (local.get $p))
          (local.set $p (+ (local.get $p) 3))
          (local.set $px (inc (local.get $px))))
        (local.set $py (inc (local.get $py))))
      (i32.const 65536)))

  ;; a still from deep in the dive, for canvas hosts
  (func (export "render") (result i32)
    (call $frame (i32.const 100)))

  ;; BT.601, integer approximation; planes at 327680, 393216, 458752
  (func $convert
    (let [$o 0 $p 65536 $r 0 $g 0 $b 0]
      (while (< (local.get $o) 65536)
        (local.set $r (i32.load8_u (local.get $p)))
        (local.set $g (i32.load8_u (+ (local.get $p) 1)))
        (local.set $b (i32.load8_u (+ (local.get $p) 2)))
        (i32.store8 (+ 327680 (local.get $o))
          (bit-shift-right (+ (+ (* 77 (local.get $r)) (* 150 (local.get $g)))
                              (* 29 (local.get $b)))
                           8))
        (i32.store8 (+ 393216 (local.get $o))
          (+ 128 (bit-shift-right (+ (- (* -43 (local.get $r)) (* 85 (local.get $g)))
                                     (* 128 (local.get $b)))
                                  8)))
        (i32.store8 (+ 458752 (local.get $o))
          (+ 128 (bit-shift-right (- (- (* 128 (local.get $r)) (* 107 (local.get $g)))
                                     (* 21 (local.get $b)))
                                  8)))
        (local.set $o (inc (local.get $o)))
        (local.set $p (+ (local.get $p) 3)))))

  ;; pipes hand back short writes; loop until every byte is gone
  (func $put (param $ptr i32) (param $len i32)
    (while (> (local.get $len) 0)
      (i32.store (i32.const 0) (local.get $ptr))
      (i32.store (i32.const 4) (local.get $len))
      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
      (local.set $ptr (+ (local.get $ptr) (i32.load (i32.const 8))))
      (local.set $len (- (local.get $len) (i32.load (i32.const 8))))))

  (func (export "_start")
    (let [$n 0]
      (call $put "YUV4MPEG2 W256 H256 F30:1 Ip A1:1 C444\n")
      (while (< (local.get $n) 150)
        (drop (call $frame (local.get $n)))
        (call $convert)
        (call $put "FRAME\n")
        (call $put (i32.const 327680) (i32.const 65536))
        (call $put (i32.const 393216) (i32.const 65536))
        (call $put (i32.const 458752) (i32.const 65536))
        (local.set $n (inc (local.get $n)))))))
