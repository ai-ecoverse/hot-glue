      (local.set $p ($a (local.get $lb)))
      ($while (local.get $p)
        (local.set $locs (call $cell (i32.const 3) ($car (local.get $p)) (local.get $locs) (i32.const 0)))
        (local.set $p ($cdr (local.get $p))))
      ;; rebuild: head, names, declared sig, declared locals, walked code
      (local.set $h ($nil))
      ($append! $h $t ($car (local.get $f)))
      (local.set $p (local.get $names-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $h $t ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $sig-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        (if (call $his ($car (local.get $p)) "param")
          (then ($append! $h $t (call $declare ($car (local.get $p)) (local.get $vars) (local.get $pb))))
          (else ($append! $h $t ($car (local.get $p)))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $locs))
      ($while (local.get $p)
        ($append! $h $t (call $declare ($car (local.get $p)) (local.get $vars) (local.get $pb)))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $code-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $h $t (call $walkc ($car (local.get $p)) (i32.const 0)
                              (local.get $vars) (local.get $pb)))
        (local.set $p ($cdr (local.get $p))))
      (local.get $h)))

  (func $lower-mod (param $m i32) (result i32)
    ($let (($h (i32.const 0)) ($t (i32.const 0)) ($p (i32.const 0)) ($c (i32.const 0))
           ($e (i32.const 0)))
      ($pool! (i32.const 0))
      ($pooloff! (i32.const 32))
      (local.set $h ($nil))
      (local.set $p (local.get $m))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        (if (call $his (local.get $c) "func")
          (then ($append! $h $t (call $lower-func (local.get $c))))
          (else ($append! $h $t (local.get $c))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $e ($pool))
      ($while (local.get $e)
        ($append! $h $t
          (call $cell (i32.const 3) (call $mksym "data")
            (call $list2
              (call $list2 (call $mksym "i32.const") ($b (local.get $e)))
              ($a (local.get $e)))
            (i32.const 0)))
        (local.set $e ($ms (local.get $e))))
      (local.get $h)))

  ;; ------------------------------------------------------ the printer

  (func $itoa! (param $v i32) (param $x i32)
    ($when (i32.lt_s (local.get $x) (i32.const 0))
      (call $byte! (local.get $v) (i32.const 45))
      (local.set $x (i32.sub (i32.const 0) (local.get $x))))
    ($when (i32.ge_u (local.get $x) (i32.const 10))
      (call $itoa-r! (local.get $v) (i32.div_u (local.get $x) (i32.const 10))))
    (call $byte! (local.get $v) (i32.add (i32.const 48) (i32.rem_u (local.get $x) (i32.const 10)))))

  (func $itoa-r! (param $v i32) (param $x i32)
    ($when (i32.ge_u (local.get $x) (i32.const 10))
      (call $itoa-r! (local.get $v) (i32.div_u (local.get $x) (i32.const 10))))
    (call $byte! (local.get $v) (i32.add (i32.const 48) (i32.rem_u (local.get $x) (i32.const 10)))))

  (func $esc! (param $v i32) (param $p i32) (param $n i32)
    ($let (($i (i32.const 0)) ($b (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $n))
        (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        ($cond
          ((i32.eq (local.get $b) (i32.const 34))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 34))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 92))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 10))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 110))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 9))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 116))
           (i32.const 0))
          (($and (i32.ge_u (local.get $b) (i32.const 32)) (i32.lt_u (local.get $b) (i32.const 127)))
           (call $byte! (local.get $v) (local.get $b))
           (i32.const 0))
          (else
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (call $hexdigit (i32.shr_u (local.get $b) (i32.const 4))))
           (call $byte! (local.get $v) (call $hexdigit (i32.and (local.get $b) (i32.const 15))))
           (i32.const 0)))
        (drop)
        ($inc! $i 1))))

  (func $hexdigit (param $d i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $d) (i32.const 10))
      (then (i32.add (local.get $d) (i32.const 48)))
      (else (i32.add (local.get $d) (i32.const 87)))))

  (func $print-flat (param $v i32) (param $n i32)
    ($let (($p (i32.const 0)) ($first (i32.const 1)))
      ($when ($sym? (local.get $n))
        (call $bytes! (local.get $v) ($a (local.get $n)) ($b (local.get $n)))
        (return))
      ($when ($num? (local.get $n))
        (call $itoa! (local.get $v) ($a (local.get $n)))
        (return))
      ($when ($str? (local.get $n))
        (call $byte! (local.get $v) (i32.const 34))
        (call $esc! (local.get $v) ($a (local.get $n)) ($b (local.get $n)))
        (call $byte! (local.get $v) (i32.const 34))
        (return))
      (call $byte! (local.get $v) (i32.const 40))
      (local.set $p (local.get $n))
      ($while ($pair? (local.get $p))
        ($unless (local.get $first) (call $byte! (local.get $v) (i32.const 32)))
        (local.set $first (i32.const 0))
        (call $print-flat (local.get $v) ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 41))))

  (func $print (param $v i32) (param $n i32) (param $d i32)
    ($let (($fv (i32.const 0)) ($p (i32.const 0)) ($j (i32.const 0)))
      ($unless ($pair? (local.get $n))
        (call $print-flat (local.get $v) (local.get $n))
        (return))
      (local.set $fv (call $vec-new (i32.const 64)))
      (call $print-flat (local.get $fv) (local.get $n))
      ($when (i32.le_u (i32.add (i32.mul (local.get $d) (i32.const 2)) ($vl (local.get $fv)))
                       (i32.const 100))
        (call $bytes! (local.get $v) ($vp (local.get $fv)) ($vl (local.get $fv)))
        (return))
      (call $byte! (local.get $v) (i32.const 40))
      (call $print (local.get $v) ($car (local.get $n)) (local.get $d))
      (local.set $p ($cdr (local.get $n)))
      ($while ($and ($pair? (local.get $p)) ($atom? ($car (local.get $p))))
        (call $byte! (local.get $v) (i32.const 32))
        (call $print-flat (local.get $v) ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      ($while ($pair? (local.get $p))
        (call $byte! (local.get $v) (i32.const 10))
        (local.set $j (i32.const 0))
        ($while (i32.lt_u (local.get $j) (i32.mul (i32.add (local.get $d) (i32.const 1)) (i32.const 2)))
          (call $byte! (local.get $v) (i32.const 32))
          ($inc! $j 1))
        (call $print (local.get $v) ($car (local.get $p)) (i32.add (local.get $d) (i32.const 1)))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 41))))

  ;; ----------------------------------------------------------- main

  (func $pipeline (result i32)
    ($let (($top-h (i32.const 0)) ($top-t (i32.const 0))
           ($out-h (i32.const 0)) ($out-t (i32.const 0))
           ($p (i32.const 0)) ($x (i32.const 0)) ($v (i32.const 0))
           ($first (i32.const 1)) ($g (i32.const 0)))
      (local.set $top-h ($nil))
      (call $skip)
      ($while (i32.lt_u ($pos) ($inlen))
        ($append! $top-h $top-t (call $parse))
        (call $skip))
      (local.set $out-h ($nil))
      (local.set $p (local.get $top-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $x (call $one ($car (local.get $p))))
        (if (call $his (local.get $x) "splice")
          (then
            (local.set $x ($cdr (local.get $x)))
            ($while (i32.eqz ($nil? (local.get $x)))
              ($append! $out-h $out-t ($car (local.get $x)))
              (local.set $x ($cdr (local.get $x)))))
          (else ($append! $out-h $out-t (local.get $x))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $v (call $vec-new (i32.const 65536)))
      (local.set $p (local.get $out-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($unless (local.get $first) (call $byte! (local.get $v) (i32.const 10)))
        (local.set $first (i32.const 0))
        (local.set $g ($car (local.get $p)))
        ($when (call $his (local.get $g) "module")
          (local.set $g (call $lower-mod (local.get $g))))
        (call $print (local.get $v) (local.get $g) (i32.const 0))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 10))
      (local.get $v)))

  (func (export "run")
    (call $init)
    (call $read-all)
    ($let (($v (call $pipeline)))
      (call $write-all ($vp (local.get $v)) ($vl (local.get $v)))))

  ;; The module-to-module protocol: another wasm module feeds source
  ;; bytes in, runs the pipeline, and pulls the WAT bytes out. Same
  ;; organs, no stdio — this is how hotglue.wasm holds the expander.
  (func (export "begin") (param $n i32)
    (call $init)
    ($reg! (i32.const 0))
    ($mark! (i32.const 0))
    ($pool! (i32.const 0))
    ($let (($v (call $vec-new (local.get $n))))
      (i32.store (i32.const 24) ($vp (local.get $v)))
      (i32.store (i32.const 28) (local.get $n))
      (i32.store (i32.const 20) (i32.const 0))))

  (func (export "in!") (param $i i32) (param $b i32)
    (i32.store8 (i32.add (i32.load (i32.const 24)) (local.get $i)) (local.get $b)))

  (func (export "go") (result i32)
    ($let (($v (call $pipeline)))
      (i32.store (i32.const 65516) ($vp (local.get $v)))
      (i32.store (i32.const 65520) ($vl (local.get $v)))
      ($vl (local.get $v))))

  (func (export "out") (param $i i32) (result i32)
    (i32.load8_u (i32.add (i32.load (i32.const 65516)) (local.get $i))))

  (func (export "outlen") (result i32)
    (i32.load (i32.const 65520))))
