;; expand.hma — the Hot Glue expander, written in Hot Glue.
;;
;; Reads Hot Glue source (defmacros and a module) on stdin. Writes the
;; expanded, lowered, printed WAT on stdout — byte-identical to what
;; stage 0 prints. A WASI reactor: `run` is the stdin-to-stdout
;; pipeline, and the begin/in!/go/out byte protocol lets hotglue.wasm
;; drive it as an imported module. Stays within the instruction
;; subset as.hma assembles, so the toolchain can build itself without
;; a text parser in sight:
;;
;;   npx tsx src/cli.ts src/expand.hma > expand.wat
;;   # feed it its own resolved source; it prints the text it runs as
;;   wasmtime run --invoke run expand.wat < resolved-expand.hma > expand2.wat
;;   diff expand.wat expand2.wat   ;; nothing
;;
;; Memory: 0 iovec, 8 io-count, 12 heap pointer, 16 nil, 20 cursor,
;; 24 input base, 28 input length. Pooled strings from 32. State at
;; 65536: +0 macro registry, +4 mark counter, +8 string pool,
;; +12 pool offset. Heap follows.
;;
;; Cells are sixteen bytes: tag, a, b, c. Tags: 0 num (a value),
;; 1 sym (a ptr, b len, c mark set), 2 str (a ptr, b len), 3 pair
;; (a car, b cdr), 4 nil, 5 closure (a params, b body, c env),
;; 6 builtin (a id), 7 macro (a params, b body). Mark sets are sorted
;; chains of pair cells; the hygiene flip toggles membership.

(use prelude.hma)

(module
  (import "wasi_snapshot_preview1" "fd_read"
    (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 256)

  ;; ---------------------------------------------------------- sugar

  (defmacro $tag (c) `(i32.load ,c))
  (defmacro $a (c) `(i32.load (i32.add ,c (i32.const 4))))
  (defmacro $b (c) `(i32.load (i32.add ,c (i32.const 8))))
  (defmacro $ms (c) `(i32.load (i32.add ,c (i32.const 12))))
  (defmacro $car (c) `($a ,c))
  (defmacro $cdr (c) `($b ,c))
  (defmacro $setb! (c x) `(i32.store (i32.add ,c (i32.const 8)) ,x))
  (defmacro $pair? (c) `(i32.eq ($tag ,c) (i32.const 3)))
  (defmacro $sym? (c) `(i32.eq ($tag ,c) (i32.const 1)))
  (defmacro $num? (c) `(i32.eq ($tag ,c) (i32.const 0)))
  (defmacro $str? (c) `(i32.eq ($tag ,c) (i32.const 2)))
  (defmacro $nil? (c) `(i32.eq ($tag ,c) (i32.const 4)))
  (defmacro $nil () `(i32.load (i32.const 16)))
  (defmacro $atom? (c) `(i32.lt_u ($tag ,c) (i32.const 3)))

  (defmacro $nth (c k)
    (if (= k 0) `($car ,c) `($nth ($cdr ,c) ,(- k 1))))

  (defmacro $vp (v) `(i32.load ,v))
  (defmacro $vl (v) `(i32.load (i32.add ,v (i32.const 4))))
  (defmacro $vc (v) `(i32.load (i32.add ,v (i32.const 8))))
  (defmacro $vl! (v x) `(i32.store (i32.add ,v (i32.const 4)) ,x))

  (defmacro $pos () `(i32.load (i32.const 20)))
  (defmacro $pos! (x) `(i32.store (i32.const 20) ,x))
  (defmacro $adv () `($pos! (i32.add ($pos) (i32.const 1))))
  (defmacro $inbase () `(i32.load (i32.const 24)))
  (defmacro $inlen () `(i32.load (i32.const 28)))
  (defmacro $byte () `(i32.load8_u (i32.add ($inbase) ($pos))))

  (defmacro $reg () `(i32.load (i32.const 65536)))
  (defmacro $reg! (x) `(i32.store (i32.const 65536) ,x))
  (defmacro $mark () `(i32.load (i32.const 65540)))
  (defmacro $mark! (x) `(i32.store (i32.const 65540) ,x))
  (defmacro $pool () `(i32.load (i32.const 65544)))
  (defmacro $pool! (x) `(i32.store (i32.const 65544) ,x))
  (defmacro $pooloff () `(i32.load (i32.const 65548)))
  (defmacro $pooloff! (x) `(i32.store (i32.const 65548) ,x))

  ;; Append x to the list being built in locals h (head) and t (tail).
  (defmacro $append! (h t x)
    `($let (($q (call $cell (i32.const 3) ,x ($nil) (i32.const 0))))
       (if (local.get ,t)
         (then ($setb! (local.get ,t) (local.get $q)))
         (else (local.set ,h (local.get $q))))
       (local.set ,t (local.get $q))))

  ;; ----------------------------------------------------------- heap

  (func $init
    (i32.store (i32.const 12) (i32.const 65552))
    (i32.store (i32.const 16) (call $cell (i32.const 4) (i32.const 0) (i32.const 0) (i32.const 0)))
    ($pooloff! (i32.const 32)))

  (func $alloc (param $n i32) (result i32)
    ($let (($p (i32.load (i32.const 12))))
      (i32.store (i32.const 12)
        (i32.and (i32.add (i32.add (local.get $p) (local.get $n)) (i32.const 3)) (i32.const -4)))
      ($while (i32.gt_u (i32.load (i32.const 12)) (i32.mul (memory.size) (i32.const 65536)))
        (drop (memory.grow (i32.const 16))))
      (local.get $p)))

  (func $cell (param $t i32) (param $x i32) (param $y i32) (param $z i32) (result i32)
    ($let (($c (call $alloc (i32.const 16))))
      (i32.store (local.get $c) (local.get $t))
      (i32.store (i32.add (local.get $c) (i32.const 4)) (local.get $x))
      (i32.store (i32.add (local.get $c) (i32.const 8)) (local.get $y))
      (i32.store (i32.add (local.get $c) (i32.const 12)) (local.get $z))
      (local.get $c)))

  (func $mknum (param $v i32) (result i32)
    (call $cell (i32.const 0) (local.get $v) (i32.const 0) (i32.const 0)))

  (func $mksym (param $p i32) (param $n i32) (result i32)
    (call $cell (i32.const 1) (local.get $p) (local.get $n) (i32.const 0)))

  (func $mkstr (param $p i32) (param $n i32) (result i32)
    (call $cell (i32.const 2) (local.get $p) (local.get $n) (i32.const 0)))

  (func $list1 (param $x i32) (result i32)
    (call $cell (i32.const 3) (local.get $x) ($nil) (i32.const 0)))

  (func $list2 (param $x i32) (param $y i32) (result i32)
    (call $cell (i32.const 3) (local.get $x) (call $list1 (local.get $y)) (i32.const 0)))

  ;; -------------------------------------------------------- strings

  (func $str-eq (param $ap i32) (param $al i32) (param $bp i32) (param $bl i32) (result i32)
    ($let (($i (i32.const 0)))
      ($when (i32.ne (local.get $al) (local.get $bl)) (return (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $al))
        ($when (i32.ne (i32.load8_u (i32.add (local.get $ap) (local.get $i)))
                       (i32.load8_u (i32.add (local.get $bp) (local.get $i))))
          (return (i32.const 0)))
        ($inc! $i 1))
      (i32.const 1)))

  ;; symbol with this name, marks ignored
  (func $cis (param $c i32) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($sym? (local.get $c))) (return (i32.const 0)))
    (call $str-eq ($a (local.get $c)) ($b (local.get $c)) (local.get $p) (local.get $n)))

  ;; list headed by this symbol, marks ignored
  (func $his (param $c i32) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($pair? (local.get $c))) (return (i32.const 0)))
    (call $cis ($car (local.get $c)) (local.get $p) (local.get $n)))

  ;; ------------------------------------------------------ mark sets

  ;; mark sets are sorted chains: pair(num-id, next). flip toggles.
  (func $mstog (param $s i32) (param $m i32) (result i32)
    ($when (i32.eqz (local.get $s))
      (return (call $cell (i32.const 3) (local.get $m) (i32.const 0) (i32.const 0))))
    ($when (i32.eq ($car (local.get $s)) (local.get $m))
      (return ($cdr (local.get $s))))
    ($when (i32.gt_u ($car (local.get $s)) (local.get $m))
      (return (call $cell (i32.const 3) (local.get $m) (local.get $s) (i32.const 0))))
    (call $cell (i32.const 3) ($car (local.get $s))
      (call $mstog ($cdr (local.get $s)) (local.get $m)) (i32.const 0)))

  (func $mseq (param $x i32) (param $y i32) (result i32)
    ($while ($and (local.get $x) (local.get $y))
      ($when (i32.ne ($car (local.get $x)) ($car (local.get $y))) (return (i32.const 0)))
      (local.set $x ($cdr (local.get $x)))
      (local.set $y ($cdr (local.get $y))))
    (i32.eqz ($or (local.get $x) (local.get $y))))

  ;; symbols equal as bindings: name and mark set both
  (func $keyeq (param $x i32) (param $y i32) (result i32)
    ($and (call $str-eq ($a (local.get $x)) ($b (local.get $x)) ($a (local.get $y)) ($b (local.get $y)))
          (call $mseq ($ms (local.get $x)) ($ms (local.get $y)))))

  ;; ----------------------------------------------------------- vecs

  (func $vec-new (param $cap i32) (result i32)
    ($let (($v (call $alloc (i32.const 12))))
      (i32.store (local.get $v) (call $alloc (local.get $cap)))
      (i32.store (i32.add (local.get $v) (i32.const 4)) (i32.const 0))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))
      (local.get $v)))

  (func $vec-room (param $v i32) (param $n i32)
    ($let (($need (i32.add ($vl (local.get $v)) (local.get $n)))
           ($cap ($vc (local.get $v)))
           ($np (i32.const 0)))
      ($when (i32.le_u (local.get $need) (local.get $cap)) (return))
      ($while (i32.lt_u (local.get $cap) (local.get $need))
        (local.set $cap (i32.mul (local.get $cap) (i32.const 2))))
      (local.set $np (call $alloc (local.get $cap)))
      (memory.copy (local.get $np) ($vp (local.get $v)) ($vl (local.get $v)))
      (i32.store (local.get $v) (local.get $np))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))))

  (func $byte! (param $v i32) (param $x i32)
    (call $vec-room (local.get $v) (i32.const 1))
    (i32.store8 (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $x))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.const 1))))

  (func $bytes! (param $v i32) (param $p i32) (param $n i32)
    (call $vec-room (local.get $v) (local.get $n))
    (memory.copy (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $p) (local.get $n))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (local.get $n))))

  ;; ------------------------------------------------------------- io

  (func $die (param $p i32) (param $n i32)
    (i32.store (i32.const 0) (local.get $p))
    (i32.store (i32.const 4) (local.get $n))
    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))
    (unreachable))

  (func $read-all
    ($let (($v (call $vec-new (i32.const 65536))))
      (block $done
        (loop $more
          (call $vec-room (local.get $v) (i32.const 65536))
          (i32.store (i32.const 0) (i32.add ($vp (local.get $v)) ($vl (local.get $v))))
          (i32.store (i32.const 4) (i32.sub ($vc (local.get $v)) ($vl (local.get $v))))
          ($when (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8))
            (call $die "read"))
          (br_if $done (i32.eqz (i32.load (i32.const 8))))
          ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.load (i32.const 8))))
          (br $more)))
      (i32.store (i32.const 24) ($vp (local.get $v)))
      (i32.store (i32.const 28) ($vl (local.get $v)))
      (i32.store (i32.const 20) (i32.const 0))))

  (func $write-all (param $p i32) (param $n i32)
    ($while (i32.gt_u (local.get $n) (i32.const 0))
      (i32.store (i32.const 0) (local.get $p))
      (i32.store (i32.const 4) (local.get $n))
      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
      ($when (i32.eqz (i32.load (i32.const 8))) (call $die "write"))
      (local.set $p (i32.add (local.get $p) (i32.load (i32.const 8))))
      (local.set $n (i32.sub (local.get $n) (i32.load (i32.const 8))))))

  ;; --------------------------------------------------------- reader

  (func $digit? (param $b i32) (result i32)
    ($and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57))))

  ;; token characters: everything above space except ( ) [ ] ; " ' ` ,
  (func $symch? (param $b i32) (result i32)
    ($when (i32.le_u (local.get $b) (i32.const 32)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 40)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 41)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 91)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 93)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 59)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 34)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 39)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 96)) (return (i32.const 0)))
    (i32.ne (local.get $b) (i32.const 44)))

  ;; whitespace and ;; comments
  (func $skip
    (block $out
      (loop $again
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.le_u ($byte) (i32.const 32)))
          ($adv))
        (br_if $out (i32.ge_u (i32.add ($pos) (i32.const 1)) ($inlen)))
        ($when ($and (i32.eq ($byte) (i32.const 59))
                     (i32.eq (i32.load8_u (i32.add (i32.add ($inbase) ($pos)) (i32.const 1))) (i32.const 59)))
          ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 10)))
            ($adv))
          (br $again)))))

  (func $parse (result i32)
    ($let (($q (i32.const 0)) ($h (i32.const 0)) ($t (i32.const 0))
           ($n (i32.const 0)) ($s (i32.const 0)) ($v (i32.const 0))
           ($neg (i32.const 0)) ($num (i32.const 1)) ($i (i32.const 0)))
      (call $skip)
      ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
      ($when (i32.eq ($byte) (i32.const 40))
        ($adv)
        (local.set $h ($nil))
        (call $skip)
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 41)))
          ($append! $h $t (call $parse))
          (call $skip))
        ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
        ($adv)
        (return (local.get $h)))
      ($when (i32.eq ($byte) (i32.const 41)) (call $die "stray"))
      ($when (i32.eq ($byte) (i32.const 91))
        ($adv)
        (local.set $h ($nil))
        (call $skip)
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 93)))
          ($append! $h $t (call $parse))
          (call $skip))
        ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
        ($adv)
        (return (local.get $h)))
      ($when (i32.eq ($byte) (i32.const 93)) (call $die "stray"))
      ($when (i32.eq ($byte) (i32.const 96))
        ($adv)
        (return (call $list2 (call $mksym "quasiquote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 44))
        ($adv)
        ($when (i32.eq ($byte) (i32.const 64))
          ($adv)
          (return (call $list2 (call $mksym "unquote-splicing") (call $parse))))
        (return (call $list2 (call $mksym "unquote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 39))
        ($adv)
        (return (call $list2 (call $mksym "quote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 34))
        ($adv)
        (local.set $v (call $vec-new (i32.const 16)))
        ($while (i32.ne ($byte) (i32.const 34))
          ($when (i32.ge_u ($pos) ($inlen)) (call $die "string"))
          (local.set $n ($byte))
          ($adv)
          ($when (i32.eq (local.get $n) (i32.const 92))
            (local.set $n ($byte))
            ($adv)
            (local.set $n
              ($cond
                ((i32.eq (local.get $n) (i32.const 110)) (i32.const 10))
                ((i32.eq (local.get $n) (i32.const 116)) (i32.const 9))
                ((i32.eq (local.get $n) (i32.const 34)) (i32.const 34))
                ((i32.eq (local.get $n) (i32.const 92)) (i32.const 92))
                (else (call $die "escape") (i32.const 0)))))
          (call $byte! (local.get $v) (local.get $n)))
        ($adv)
        (return (call $mkstr ($vp (local.get $v)) ($vl (local.get $v)))))
      ;; token: scan, then classify as number or symbol
      (local.set $s ($pos))
      ($while ($and (i32.lt_u ($pos) ($inlen)) (call $symch? ($byte)))
        ($adv))
      ($when (i32.eq ($pos) (local.get $s)) (call $die "token"))
      (local.set $i (local.get $s))
      (local.set $neg (i32.eq (i32.load8_u (i32.add ($inbase) (local.get $s))) (i32.const 45)))
      ($when (local.get $neg) (local.set $i (i32.add (local.get $i) (i32.const 1))))
      ($when (i32.ge_u (local.get $i) ($pos)) (local.set $num (i32.const 0)))
      ($let (($j (local.get $i)))
        ($while (i32.lt_u (local.get $j) ($pos))
          ($unless (call $digit? (i32.load8_u (i32.add ($inbase) (local.get $j))))
            (local.set $num (i32.const 0)))
          ($inc! $j 1)))
      ($when (local.get $num)
        (local.set $n (i32.const 0))
        ($while (i32.lt_u (local.get $i) ($pos))
          (local.set $n (i32.add (i32.mul (local.get $n) (i32.const 10))
                                 (i32.sub (i32.load8_u (i32.add ($inbase) (local.get $i))) (i32.const 48))))
          ($inc! $i 1))
        ($when (local.get $neg) (local.set $n (i32.sub (i32.const 0) (local.get $n))))
        (return (call $mknum (local.get $n))))
      (call $mksym (i32.add ($inbase) (local.get $s)) (i32.sub ($pos) (local.get $s)))))

  ;; -------------------------------------------------- the meta-Lisp

  ;; environments: chain of pair(pair(sym . val) . next), 0 is empty
  (func $bind (param $env i32) (param $s i32) (param $v i32) (result i32)
    (call $cell (i32.const 3)
      (call $cell (i32.const 3) (local.get $s) (local.get $v) (i32.const 0))
      (local.get $env) (i32.const 0)))

  (func $builtin-id (param $p i32) (param $n i32) (result i32)
    ($ops (local.get $p) (local.get $n)
      (0 "first" 1)
      (0 "second" 2)
      (0 "rest" 3)
      (0 "length" 4)
      (0 "map" 5)
      (0 "=" 6)
      (0 "+" 7)
      (0 "-" 8)
      (0 "*" 9)
      (0 "sym-is?" 10)
      (0 "list?" 11)
      (0 "sym?" 12))
    (i32.const 0))

  (func $lookup (param $env i32) (param $s i32) (result i32)
    ($let (($e (local.get $env)) ($id (i32.const 0)))
      ($while (local.get $e)
        ($when (call $keyeq ($car ($car (local.get $e))) (local.get $s))
          (return ($cdr ($car (local.get $e)))))
        (local.set $e ($cdr (local.get $e))))
      (local.set $id (call $builtin-id ($a (local.get $s)) ($b (local.get $s))))
      ($when (local.get $id)
        (return (call $cell (i32.const 6) (local.get $id) (i32.const 0) (i32.const 0))))
      (call $die "unbound")
      (i32.const 0)))

  (func $truthy (param $v i32) (result i32)
    ($when ($num? (local.get $v)) (return (i32.ne ($a (local.get $v)) (i32.const 0))))
    (i32.const 1))

  (func $eval (param $n i32) (param $env i32) (result i32)
    ($let (($h (i32.const 0)) ($f (i32.const 0)) ($p (i32.const 0))
           ($ah (i32.const 0)) ($at (i32.const 0)))
      ($when ($sym? (local.get $n)) (return (call $lookup (local.get $env) (local.get $n))))
      ($unless ($pair? (local.get $n)) (return (local.get $n)))
      (local.set $h ($car (local.get $n)))
      ($when ($sym? (local.get $h))
        ($when (call $cis (local.get $h) "quote")
          (return ($nth (local.get $n) 1)))
        ($when (call $cis (local.get $h) "quasiquote")
          (return (call $qq ($nth (local.get $n) 1) (local.get $env))))
        ($when (call $cis (local.get $h) "if")
          ($when (call $truthy (call $eval ($nth (local.get $n) 1) (local.get $env)))
            (return (call $eval ($nth (local.get $n) 2) (local.get $env))))
          ($when ($nil? ($cdr ($cdr ($cdr (local.get $n)))))
            (return ($nil)))
          (return (call $eval ($nth (local.get $n) 3) (local.get $env))))
        ($when (call $cis (local.get $h) "lambda")
          (return (call $cell (i32.const 5) ($nth (local.get $n) 1)
                        ($cdr ($cdr (local.get $n))) (local.get $env)))))
      (local.set $f (call $eval (local.get $h) (local.get $env)))
      (local.set $ah ($nil))
      (local.set $p ($cdr (local.get $n)))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $ah $at (call $eval ($car (local.get $p)) (local.get $env)))
