  (func $memory-sec (param $mod i32) (result i32)
    ($let (($v (i32.const 0)) ($p (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "memory")
          (local.set $v (call $vec-new (i32.const 8)))
