;; as.hma — a WebAssembly assembler, written in Hot Glue.
;;
;; Reads WAT text (the dialect stage 0 prints) on stdin. Writes a
;; binary module on stdout. Runs under any WASI runtime:
;;
;;   npx tsx src/hotglue/cli.ts src/hotglue/prelude.hma src/hotglue/as.hma > as.wat
;;   wasmtime as.wat < program.wat > program.wasm
;;
;; Self-hosting: as.wat assembles its own text, and the binary it
;; produces assembles it again, byte for byte.
;;
;; Memory: 0 iovec, 8 io-count, 12 heap pointer, 16 nil, 20 cursor,
;; 24 input base, 28 input length. Pooled strings from 32. Heap from
;; 65536. Cells are twelve bytes: tag, a, b. Tags: 0 num (a value),
;; 1 sym (a ptr, b len), 2 str (a ptr, b len), 3 pair (a car, b cdr),
;; 4 nil.

(use prelude.hma)

(module
  (import "wasi_snapshot_preview1" "fd_read"
    (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 256)

  ;; ---------------------------------------------------------- sugar

  (defmacro $tag (c) `(i32.load ,c))
  (defmacro $a (c) `(i32.load (i32.add ,c (i32.const 4))))
  (defmacro $b (c) `(i32.load (i32.add ,c (i32.const 8))))
  (defmacro $car (c) `($a ,c))
  (defmacro $cdr (c) `($b ,c))
  (defmacro $set-b! (c x) `(i32.store (i32.add ,c (i32.const 8)) ,x))
  (defmacro $pair? (c) `(i32.eq ($tag ,c) (i32.const 3)))
  (defmacro $sym? (c) `(i32.eq ($tag ,c) (i32.const 1)))
  (defmacro $num? (c) `(i32.eq ($tag ,c) (i32.const 0)))
  (defmacro $nil? (c) `(i32.eq ($tag ,c) (i32.const 4)))
  (defmacro $nil () `(i32.load (i32.const 16)))

  (defmacro $nth (c k)
    (if (= k 0) `($car ,c) `($nth ($cdr ,c) ,(- k 1))))

  (defmacro $vp (v) `(i32.load ,v))
  (defmacro $vl (v) `(i32.load (i32.add ,v (i32.const 4))))
  (defmacro $vc (v) `(i32.load (i32.add ,v (i32.const 8))))
  (defmacro $vl! (v x) `(i32.store (i32.add ,v (i32.const 4)) ,x))

  (defmacro $pos () `(i32.load (i32.const 20)))
  (defmacro $pos! (x) `(i32.store (i32.const 20) ,x))
  (defmacro $adv () `($pos! (i32.add ($pos) (i32.const 1))))
  (defmacro $inbase () `(i32.load (i32.const 24)))
  (defmacro $inlen () `(i32.load (i32.const 28)))
  (defmacro $byte () `(i32.load8_u (i32.add ($inbase) ($pos))))

  ;; Walk the module's fields, binding each to var.
  (defmacro $each-field (mod var &rest body)
    `($let (($fs ($cdr ,mod)) (,var (i32.const 0)))
       ($while (i32.eqz ($nil? (local.get $fs)))
         (local.set ,var ($car (local.get $fs)))
         ,@body
         (local.set $fs ($cdr (local.get $fs))))))

  ;; ----------------------------------------------------------- heap

  (func $init
    (i32.store (i32.const 12) (i32.const 65536))
    (i32.store (i32.const 16) (call $cell (i32.const 4) (i32.const 0) (i32.const 0))))

  (func $alloc (param $n i32) (result i32)
    ($let (($p (i32.load (i32.const 12))))
      (i32.store (i32.const 12)
        (i32.and (i32.add (i32.add (local.get $p) (local.get $n)) (i32.const 3)) (i32.const -4)))
      ($while (i32.gt_u (i32.load (i32.const 12)) (i32.mul (memory.size) (i32.const 65536)))
        (drop (memory.grow (i32.const 16))))
      (local.get $p)))

  (func $cell (param $t i32) (param $x i32) (param $y i32) (result i32)
    ($let (($c (call $alloc (i32.const 12))))
      (i32.store (local.get $c) (local.get $t))
      (i32.store (i32.add (local.get $c) (i32.const 4)) (local.get $x))
      (i32.store (i32.add (local.get $c) (i32.const 8)) (local.get $y))
      (local.get $c)))

  ;; -------------------------------------------------------- strings

  (func $str-eq (param $ap i32) (param $al i32) (param $bp i32) (param $bl i32) (result i32)
    ($let (($i (i32.const 0)))
      ($when (i32.ne (local.get $al) (local.get $bl)) (return (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $al))
        ($when (i32.ne (i32.load8_u (i32.add (local.get $ap) (local.get $i)))
                       (i32.load8_u (i32.add (local.get $bp) (local.get $i))))
          (return (i32.const 0)))
        ($inc! $i 1))
      (i32.const 1)))

  ;; cell is a symbol with this name
  (func $cis (param $c i32) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($sym? (local.get $c))) (return (i32.const 0)))
    (call $str-eq ($a (local.get $c)) ($b (local.get $c)) (local.get $p) (local.get $n)))

  ;; cell is a list headed by this symbol
  (func $his (param $c i32) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($pair? (local.get $c))) (return (i32.const 0)))
    (call $cis ($car (local.get $c)) (local.get $p) (local.get $n)))

  (func $sym-eq (param $x i32) (param $y i32) (result i32)
    (call $str-eq ($a (local.get $x)) ($b (local.get $x)) ($a (local.get $y)) ($b (local.get $y))))

  ;; ----------------------------------------------------------- vecs

  (func $vec-new (param $cap i32) (result i32)
    ($let (($v (call $alloc (i32.const 12))))
      (i32.store (local.get $v) (call $alloc (local.get $cap)))
      (i32.store (i32.add (local.get $v) (i32.const 4)) (i32.const 0))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))
      (local.get $v)))

  (func $vec-room (param $v i32) (param $n i32)
    ($let (($need (i32.add ($vl (local.get $v)) (local.get $n)))
           ($cap ($vc (local.get $v)))
           ($np (i32.const 0)))
      ($when (i32.le_u (local.get $need) (local.get $cap)) (return))
      ($while (i32.lt_u (local.get $cap) (local.get $need))
        (local.set $cap (i32.mul (local.get $cap) (i32.const 2))))
      (local.set $np (call $alloc (local.get $cap)))
      (memory.copy (local.get $np) ($vp (local.get $v)) ($vl (local.get $v)))
      (i32.store (local.get $v) (local.get $np))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))))

  (func $byte! (param $v i32) (param $x i32)
    (call $vec-room (local.get $v) (i32.const 1))
    (i32.store8 (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $x))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.const 1))))

  (func $bytes! (param $v i32) (param $p i32) (param $n i32)
    (call $vec-room (local.get $v) (local.get $n))
    (memory.copy (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $p) (local.get $n))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (local.get $n))))

  (func $lenbytes! (param $v i32) (param $p i32) (param $n i32)
    (call $uleb! (local.get $v) (local.get $n))
    (call $bytes! (local.get $v) (local.get $p) (local.get $n)))

  (func $uleb! (param $v i32) (param $x i32)
    (loop $more
      ($when (i32.ge_u (local.get $x) (i32.const 128))
        (call $byte! (local.get $v) (i32.or (i32.and (local.get $x) (i32.const 127)) (i32.const 128)))
        (local.set $x (i32.shr_u (local.get $x) (i32.const 7)))
        (br $more)))
    (call $byte! (local.get $v) (local.get $x)))

  (func $sleb! (param $v i32) (param $x i32)
    ($let (($b (i32.const 0)) ($done (i32.const 0)))
      ($while (i32.eqz (local.get $done))
        (local.set $b (i32.and (local.get $x) (i32.const 127)))
        (local.set $x (i32.shr_s (local.get $x) (i32.const 7)))
        (local.set $done
          ($or ($and (i32.eq (local.get $x) (i32.const 0))
                     (i32.eqz (i32.and (local.get $b) (i32.const 64))))
               ($and (i32.eq (local.get $x) (i32.const -1))
                     (i32.and (local.get $b) (i32.const 64)))))
        (call $byte! (local.get $v)
          (i32.or (local.get $b)
                  (if (result i32) (local.get $done) (then (i32.const 0)) (else (i32.const 128))))))))

  ;; ------------------------------------------------------------- io

  (func $die (param $p i32) (param $n i32)
    (i32.store (i32.const 0) (local.get $p))
    (i32.store (i32.const 4) (local.get $n))
    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))
    (unreachable))

  (func $read-all
    ($let (($v (call $vec-new (i32.const 65536))))
      (block $done
        (loop $more
          (call $vec-room (local.get $v) (i32.const 65536))
          (i32.store (i32.const 0) (i32.add ($vp (local.get $v)) ($vl (local.get $v))))
          (i32.store (i32.const 4) (i32.sub ($vc (local.get $v)) ($vl (local.get $v))))
          ($when (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8))
            (call $die "read"))
          (br_if $done (i32.eqz (i32.load (i32.const 8))))
          ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.load (i32.const 8))))
          (br $more)))
      (i32.store (i32.const 24) ($vp (local.get $v)))
      (i32.store (i32.const 28) ($vl (local.get $v)))
      (i32.store (i32.const 20) (i32.const 0))))

  (func $write-all (param $p i32) (param $n i32)
    ($while (i32.gt_u (local.get $n) (i32.const 0))
      (i32.store (i32.const 0) (local.get $p))
      (i32.store (i32.const 4) (local.get $n))
      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
      ($when (i32.eqz (i32.load (i32.const 8))) (call $die "write"))
      (local.set $p (i32.add (local.get $p) (i32.load (i32.const 8))))
      (local.set $n (i32.sub (local.get $n) (i32.load (i32.const 8))))))

  ;; --------------------------------------------------------- reader

  (func $digit? (param $b i32) (result i32)
    ($and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57))))

  (func $symch? (param $b i32) (result i32)
    ($and (i32.gt_u (local.get $b) (i32.const 32))
          ($and (i32.ne (local.get $b) (i32.const 40))
                ($and (i32.ne (local.get $b) (i32.const 41))
                      (i32.ne (local.get $b) (i32.const 34))))))

  (func $hex (param $b i32) (result i32)
    (if (result i32) (i32.le_u (local.get $b) (i32.const 57))
      (then (i32.sub (local.get $b) (i32.const 48)))
      (else (i32.sub (local.get $b) (i32.const 87)))))

  (func $hex-adv (result i32)
    ($let (($b ($byte)))
      ($adv)
      (call $hex (local.get $b))))

  (func $skip-ws
    ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.le_u ($byte) (i32.const 32)))
      ($adv)))

  (func $parse (result i32)
    ($let (($c (i32.const 0)) ($h (i32.const 0)) ($t (i32.const 0))
           ($n (i32.const 0)) ($s (i32.const 0)) ($v (i32.const 0)) ($neg (i32.const 0))
           ($num (i32.const 1)) ($i (i32.const 0)))
      (call $skip-ws)
      ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
      ($when (i32.eq ($byte) (i32.const 40))
        ($adv)
        (local.set $h ($nil))
        (call $skip-ws)
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 41)))
          (local.set $c (call $cell (i32.const 3) (call $parse) ($nil)))
          (if (local.get $t)
            (then ($set-b! (local.get $t) (local.get $c)))
            (else (local.set $h (local.get $c))))
          (local.set $t (local.get $c))
          (call $skip-ws))
        ($adv)
        (return (local.get $h)))
      ($when (i32.eq ($byte) (i32.const 34))
        ($adv)
        (local.set $v (call $vec-new (i32.const 16)))
        ($while (i32.ne ($byte) (i32.const 34))
          (local.set $n ($byte))
          ($adv)
          ($when (i32.eq (local.get $n) (i32.const 92))
            (local.set $n ($byte))
            ($adv)
            (local.set $n
              ($cond
                ((i32.eq (local.get $n) (i32.const 110)) (i32.const 10))
                ((i32.eq (local.get $n) (i32.const 116)) (i32.const 9))
                ((i32.eq (local.get $n) (i32.const 34)) (i32.const 34))
                ((i32.eq (local.get $n) (i32.const 92)) (i32.const 92))
                (else (i32.add (i32.mul (call $hex (local.get $n)) (i32.const 16)) (call $hex-adv))))))
          (call $byte! (local.get $v) (local.get $n)))
        ($adv)
        (return (call $cell (i32.const 2) ($vp (local.get $v)) ($vl (local.get $v)))))
      ;; token: scan whole, then classify — a float literal is a
      ;; symbol here; only pure integers become numbers
      (local.set $s ($pos))
      ($while ($and (i32.lt_u ($pos) ($inlen)) (call $symch? ($byte)))
        ($adv))
      (local.set $i (local.get $s))
      (local.set $neg (i32.eq (i32.load8_u (i32.add ($inbase) (local.get $s))) (i32.const 45)))
      ($when (local.get $neg) (local.set $i (i32.add (local.get $i) (i32.const 1))))
      (local.set $num (i32.const 1))
      ($when (i32.ge_u (local.get $i) ($pos)) (local.set $num (i32.const 0)))
      ($let (($j (local.get $i)))
        ($while (i32.lt_u (local.get $j) ($pos))
          ($unless (call $digit? (i32.load8_u (i32.add ($inbase) (local.get $j))))
            (local.set $num (i32.const 0)))
          ($inc! $j 1)))
      ($when (local.get $num)
        (local.set $n (i32.const 0))
        ($while (i32.lt_u (local.get $i) ($pos))
          (local.set $n (i32.add (i32.mul (local.get $n) (i32.const 10))
                                 (i32.sub (i32.load8_u (i32.add ($inbase) (local.get $i))) (i32.const 48))))
          (local.set $i (i32.add (local.get $i) (i32.const 1))))
        ($when (local.get $neg) (local.set $n (i32.sub (i32.const 0) (local.get $n))))
        (return (call $cell (i32.const 0) (local.get $n) (i32.const 0))))
      (call $cell (i32.const 1) (i32.add ($inbase) (local.get $s)) (i32.sub ($pos) (local.get $s)))))

  ;; ------------------------------------------------------- mnemonics
  ;; class 0 bare, 1 const, 2 local, 3 call, 4 branch, 5 mem align 2,
  ;; 6 mem align 0, 7 op then zero byte, 8 memory.copy, 9 memory.fill

  (func $op-code (param $p i32) (param $n i32) (result i32)
    ($ops (local.get $p) (local.get $n)
      (0 "unreachable" 0)
      (0 "nop" 1)
      (0 "return" 15)
      (0 "drop" 26)
      (0 "select" 27)
      (3 "call" 16)
      (4 "br" 12)
      (4 "br_if" 13)
      (2 "local.get" 32)
      (2 "local.set" 33)
      (2 "local.tee" 34)
      (1 "i32.const" 65)
      (5 "i32.load" 40)
      (6 "i32.load8_s" 44)
      (6 "i32.load8_u" 45)
      (5 "i32.store" 54)
      (6 "i32.store8" 58)
      (7 "memory.size" 63)
      (7 "memory.grow" 64)
      (8 "memory.copy" 10)
      (9 "memory.fill" 11)
      (0 "i32.eqz" 69)
      (0 "i32.eq" 70)
      (0 "i32.ne" 71)
      (0 "i32.lt_s" 72)
      (0 "i32.lt_u" 73)
      (0 "i32.gt_s" 74)
      (0 "i32.gt_u" 75)
      (0 "i32.le_s" 76)
      (0 "i32.le_u" 77)
      (0 "i32.ge_s" 78)
      (0 "i32.ge_u" 79)
      (0 "i32.clz" 103)
      (0 "i32.ctz" 104)
      (0 "i32.popcnt" 105)
      (0 "i32.add" 106)
      (0 "i32.sub" 107)
      (0 "i32.mul" 108)
      (0 "i32.div_s" 109)
      (0 "i32.div_u" 110)
      (0 "i32.rem_s" 111)
      (0 "i32.rem_u" 112)
      (0 "i32.and" 113)
      (0 "i32.or" 114)
      (0 "i32.xor" 115)
      (0 "i32.shl" 116)
      (0 "i32.shr_s" 117)
      (0 "i32.shr_u" 118)
      (0 "i32.rotl" 119)
      (0 "i32.rotr" 120)
      (0 "ref.as_non_null" 212)
      (0 "ref.is_null" 209)
      (0 "ref.eq" 211)
      (10 "struct.new" 0)
      (10 "array.new" 6)
      (10 "array.new_default" 7)
      (10 "array.get" 11)
      (10 "array.get_s" 12)
      (10 "array.get_u" 13)
      (10 "array.set" 14)
      (11 "struct.get" 2)
      (11 "struct.set" 5)
      (11 "array.new_fixed" 8)
      (12 "ref.test" 20)
      (12 "ref.cast" 22)
      (13 "br_on_cast" 24)
      (14 "array.len" 15)
      (14 "ref.i31" 28)
      (14 "i31.get_s" 29)
      (14 "i31.get_u" 30)
      (15 "ref.null" 208)
      (16 "f64.const" 68)
      (17 "f32.const" 67)
      (18 "f64.load" 43)
      (18 "f64.store" 57)
      (19 "f32.load" 42)
      (19 "f32.store" 56)
      (20 "i32.load16_s" 46)
      (20 "i32.load16_u" 47)
      (20 "i32.store16" 59)
      (0 "f64.eq" 97)
      (0 "f64.ne" 98)
      (0 "f64.lt" 99)
      (0 "f64.gt" 100)
      (0 "f64.le" 101)
      (0 "f64.ge" 102)
      (0 "f64.abs" 153)
      (0 "f64.neg" 154)
      (0 "f64.ceil" 155)
      (0 "f64.floor" 156)
      (0 "f64.trunc" 157)
      (0 "f64.nearest" 158)
      (0 "f64.sqrt" 159)
      (0 "f64.add" 160)
      (0 "f64.sub" 161)
      (0 "f64.mul" 162)
      (0 "f64.div" 163)
      (0 "f64.min" 164)
      (0 "f64.max" 165)
      (0 "f64.copysign" 166)
      (0 "f32.eq" 91)
      (0 "f32.ne" 92)
      (0 "f32.lt" 93)
      (0 "f32.gt" 94)
      (0 "f32.le" 95)
      (0 "f32.ge" 96)
      (0 "f32.abs" 139)
      (0 "f32.neg" 140)
      (0 "f32.nearest" 144)
      (0 "f32.sqrt" 145)
      (0 "f32.add" 146)
      (0 "f32.sub" 147)
      (0 "f32.mul" 148)
      (0 "f32.div" 149)
      (0 "f32.min" 150)
      (0 "f32.max" 151)
      (0 "i32.trunc_f32_s" 168)
      (0 "i32.trunc_f32_u" 169)
      (0 "i32.trunc_f64_s" 170)
      (0 "i32.trunc_f64_u" 171)
      (0 "f32.convert_i32_s" 178)
      (0 "f32.convert_i32_u" 179)
      (0 "f32.demote_f64" 182)
      (0 "f64.convert_i32_s" 183)
      (0 "f64.convert_i32_u" 184)
      (0 "f64.promote_f32" 187)
      (0 "i32.reinterpret_f32" 188)
      (0 "f32.reinterpret_i32" 190))
    (call $die "op?")
    (i32.const 0))

  ;; ------------------------------------------------------- GC types

  (func $has-types (param $mod i32) (result i32)
    ($or (call $nfields (local.get $mod) "type") (call $nfields (local.get $mod) "rec")))

  ;; flattened index of a named type across (rec ...) and (type ...) fields
  (func $type-index (param $mod i32) (param $s i32) (result i32)
    ($let (($i (i32.const 0)) ($p (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "type")
          ($when (call $sym-eq ($nth (local.get $f) 1) (local.get $s)) (return (local.get $i)))
          ($inc! $i 1))
        ($when (call $his (local.get $f) "rec")
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            ($when (call $sym-eq ($nth ($car (local.get $p)) 1) (local.get $s))
              (return (local.get $i)))
            ($inc! $i 1)
            (local.set $p ($cdr (local.get $p))))))
      (call $die "type?")
      (i32.const 0)))

  (func $dollar? (param $c i32) (result i32)
    ($and ($sym? (local.get $c)) (i32.eq (i32.load8_u ($a (local.get $c))) (i32.const 36))))

  (func $rtnull? (param $c i32) (result i32)
    (call $cis ($nth (local.get $c) 1) "null"))

  (func $rtty (param $c i32) (result i32)
    (if (result i32) (call $rtnull? (local.get $c))
      (then ($nth (local.get $c) 2))
      (else ($nth (local.get $c) 1))))

  ;; abstract heap types are their own single byte; concrete ones an index
  (func $heaptype! (param $v i32) (param $s i32) (param $mod i32)
    ($when (call $cis (local.get $s) "any") (call $byte! (local.get $v) (i32.const 110)) (return))
    ($when (call $cis (local.get $s) "eq") (call $byte! (local.get $v) (i32.const 109)) (return))
    ($when (call $cis (local.get $s) "i31") (call $byte! (local.get $v) (i32.const 108)) (return))
    ($when (call $cis (local.get $s) "struct") (call $byte! (local.get $v) (i32.const 107)) (return))
    ($when (call $cis (local.get $s) "array") (call $byte! (local.get $v) (i32.const 106)) (return))
    ($when (call $cis (local.get $s) "none") (call $byte! (local.get $v) (i32.const 113)) (return))
    ($when (call $cis (local.get $s) "func") (call $byte! (local.get $v) (i32.const 112)) (return))
    ($when (call $cis (local.get $s) "extern") (call $byte! (local.get $v) (i32.const 111)) (return))
    (call $sleb! (local.get $v) (call $type-index (local.get $mod) (local.get $s))))

  (func $valtype! (param $v i32) (param $c i32) (param $mod i32)
    ($when (call $cis (local.get $c) "i32") (call $byte! (local.get $v) (i32.const 127)) (return))
    ($when (call $cis (local.get $c) "i64") (call $byte! (local.get $v) (i32.const 126)) (return))
    ($when (call $cis (local.get $c) "f32") (call $byte! (local.get $v) (i32.const 125)) (return))
    ($when (call $cis (local.get $c) "f64") (call $byte! (local.get $v) (i32.const 124)) (return))
    ($when (call $cis (local.get $c) "anyref") (call $byte! (local.get $v) (i32.const 110)) (return))
    ($when (call $cis (local.get $c) "eqref") (call $byte! (local.get $v) (i32.const 109)) (return))
    ($when (call $cis (local.get $c) "i31ref") (call $byte! (local.get $v) (i32.const 108)) (return))
    ($when (call $his (local.get $c) "ref")
      (if (call $rtnull? (local.get $c))
        (then (call $byte! (local.get $v) (i32.const 99)))
        (else (call $byte! (local.get $v) (i32.const 100))))
      (call $heaptype! (local.get $v) (call $rtty (local.get $c)) (local.get $mod))
      (return))
    (call $die "valtype?"))

  (func $storage! (param $v i32) (param $c i32) (param $mod i32)
    ($when (call $cis (local.get $c) "i8") (call $byte! (local.get $v) (i32.const 120)) (return))
    ($when (call $cis (local.get $c) "i16") (call $byte! (local.get $v) (i32.const 119)) (return))
    (call $valtype! (local.get $v) (local.get $c) (local.get $mod)))

  ;; a field's storage plus its mutability byte, (mut ...) unwrapped
  (func $fieldtype! (param $v i32) (param $c i32) (param $mod i32)
    (if (call $his (local.get $c) "mut")
      (then (call $storage! (local.get $v) ($nth (local.get $c) 1) (local.get $mod))
            (call $byte! (local.get $v) (i32.const 1)))
      (else (call $storage! (local.get $v) (local.get $c) (local.get $mod))
            (call $byte! (local.get $v) (i32.const 0)))))

  ;; the items of every (head ...) child of x: count, then valtype each,
  ;; a trailing zero mutability byte when these are struct fields
  (func $items! (param $v i32) (param $x i32) (param $hp i32) (param $hn i32)
                (param $mut i32) (param $mod i32)
    ($let (($n (i32.const 0)) ($p (i32.const 0)) ($q (i32.const 0)) ($c (i32.const 0)))
      (local.set $p ($cdr (local.get $x)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        ($when (call $his (local.get $c) (local.get $hp) (local.get $hn))
          (local.set $q ($cdr (local.get $c)))
          ($while (i32.eqz ($nil? (local.get $q)))
            ($unless (call $dollar? ($car (local.get $q))) ($inc! $n 1))
            (local.set $q ($cdr (local.get $q)))))
        (local.set $p ($cdr (local.get $p))))
      (call $uleb! (local.get $v) (local.get $n))
      (local.set $p ($cdr (local.get $x)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        ($when (call $his (local.get $c) (local.get $hp) (local.get $hn))
          (local.set $q ($cdr (local.get $c)))
          ($while (i32.eqz ($nil? (local.get $q)))
            ($unless (call $dollar? ($car (local.get $q)))
              (if (local.get $mut)
                (then (call $fieldtype! (local.get $v) ($car (local.get $q)) (local.get $mod)))
                (else (call $valtype! (local.get $v) ($car (local.get $q)) (local.get $mod)))))
            (local.set $q ($cdr (local.get $q)))))
        (local.set $p ($cdr (local.get $p))))))

  (func $comptype! (param $v i32) (param $x i32) (param $mod i32)
    ($when (call $his (local.get $x) "struct")
      (call $byte! (local.get $v) (i32.const 95))
      (call $items! (local.get $v) (local.get $x) "field" (i32.const 1) (local.get $mod))
      (return))
    ($when (call $his (local.get $x) "array")
      (call $byte! (local.get $v) (i32.const 94))
      (call $fieldtype! (local.get $v) ($nth (local.get $x) 1) (local.get $mod))
      (return))
    ($when (call $his (local.get $x) "func")
      (call $byte! (local.get $v) (i32.const 96))
      (call $items! (local.get $v) (local.get $x) "param" (i32.const 0) (local.get $mod))
      (call $items! (local.get $v) (local.get $x) "result" (i32.const 0) (local.get $mod))
      (return))
    (call $die "comptype?"))

  (func $subtype! (param $v i32) (param $x i32) (param $mod i32)
    ($let (($p (i32.const 0)) ($n (i32.const 0)) ($fin (i32.const 0)) ($q (i32.const 0)))
      ($unless (call $his (local.get $x) "sub")
        (call $comptype! (local.get $v) (local.get $x) (local.get $mod))
        (return))
      (local.set $p ($cdr (local.get $x)))
      ($when (call $cis ($car (local.get $p)) "final")
        (local.set $fin (i32.const 1))
        (local.set $p ($cdr (local.get $p))))
      (local.set $q (local.get $p))
      ($while ($sym? ($car (local.get $q)))
        ($inc! $n 1)
        (local.set $q ($cdr (local.get $q))))
      (call $byte! (local.get $v)
        (if (result i32) (local.get $fin) (then (i32.const 79)) (else (i32.const 80))))
      (call $uleb! (local.get $v) (local.get $n))
      ($while ($sym? ($car (local.get $p)))
        (call $uleb! (local.get $v) (call $type-index (local.get $mod) ($car (local.get $p))))
        (local.set $p ($cdr (local.get $p))))
      (call $comptype! (local.get $v) ($car (local.get $p)) (local.get $mod))))

  (func $type-sec-x (param $mod i32) (result i32)
    ($let (($v (call $vec-new (i32.const 128))) ($p (i32.const 0)) ($n (i32.const 0)))
      (call $uleb! (local.get $v)
        (i32.add (call $nfields (local.get $mod) "type") (call $nfields (local.get $mod) "rec")))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "rec")
          (call $byte! (local.get $v) (i32.const 78))
          (local.set $n (i32.const 0))
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            ($inc! $n 1)
            (local.set $p ($cdr (local.get $p))))
          (call $uleb! (local.get $v) (local.get $n))
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            (call $subtype! (local.get $v) ($nth ($car (local.get $p)) 2) (local.get $mod))
            (local.set $p ($cdr (local.get $p)))))
        ($when (call $his (local.get $f) "type")
          (call $subtype! (local.get $v) ($nth (local.get $f) 2) (local.get $mod))))
      (local.get $v)))

  ;; ------------------------------------------------------- floats
  ;; Parse a float token into the f64 scratch at 65528 (below the
  ;; heap, above the string pool). Grammar: sign, digits, point,
  ;; digits, e-exponent. The assembler computes in f64 internally —
  ;; it can afford to, since it is the one teaching itself to encode
  ;; f64. Accuracy is a naive parse's: within an ulp or two of a
  ;; perfect strtod, deterministic always.

  (func $fparse (param $p i32) (param $n i32)
    ($let (($i (i32.const 0)) ($b (i32.const 0)) ($sign (i32.const 0))
           ($dexp (i32.const 0)) ($esign (i32.const 0)) ($e (i32.const 0))
           ($v f64 (f64.convert_i32_s (i32.const 0))))
      ($when ($and (i32.gt_u (local.get $n) (i32.const 0))
                   (i32.eq (i32.load8_u (local.get $p)) (i32.const 45)))
        (local.set $sign (i32.const 1))
        ($inc! $i 1))
      ($while ($and (i32.lt_u (local.get $i) (local.get $n))
                    (call $digit? (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
        (local.set $v (f64.add (f64.mul (local.get $v) (f64.convert_i32_s (i32.const 10)))
          (f64.convert_i32_s (i32.sub (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 48)))))
        ($inc! $i 1))
      ($when ($and (i32.lt_u (local.get $i) (local.get $n))
                   (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 46)))
        ($inc! $i 1)
        ($while ($and (i32.lt_u (local.get $i) (local.get $n))
                      (call $digit? (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
          (local.set $v (f64.add (f64.mul (local.get $v) (f64.convert_i32_s (i32.const 10)))
            (f64.convert_i32_s (i32.sub (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 48)))))
          (local.set $dexp (i32.sub (local.get $dexp) (i32.const 1)))
          ($inc! $i 1)))
      ($when (i32.lt_u (local.get $i) (local.get $n))
        (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        ($when ($or (i32.eq (local.get $b) (i32.const 101)) (i32.eq (local.get $b) (i32.const 69)))
          ($inc! $i 1)
          (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $i))))
          ($when (i32.eq (local.get $b) (i32.const 45))
            (local.set $esign (i32.const 1))
            ($inc! $i 1))
          ($when (i32.eq (local.get $b) (i32.const 43))
            ($inc! $i 1))
          ($while ($and (i32.lt_u (local.get $i) (local.get $n))
                        (call $digit? (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
            (local.set $e (i32.add (i32.mul (local.get $e) (i32.const 10))
              (i32.sub (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 48))))
            ($inc! $i 1))
          ($when (local.get $esign) (local.set $e (i32.sub (i32.const 0) (local.get $e))))
          (local.set $dexp (i32.add (local.get $dexp) (local.get $e)))))
      ($when (local.get $sign) (local.set $v (f64.neg (local.get $v))))
      ($while (i32.gt_s (local.get $dexp) (i32.const 0))
        (local.set $v (f64.mul (local.get $v) (f64.convert_i32_s (i32.const 10))))
        (local.set $dexp (i32.sub (local.get $dexp) (i32.const 1))))
      ($while (i32.lt_s (local.get $dexp) (i32.const 0))
        (local.set $v (f64.div (local.get $v) (f64.convert_i32_s (i32.const 10))))
        (local.set $dexp (i32.add (local.get $dexp) (i32.const 1))))
      (f64.store (i32.const 65528) (local.get $v))))

  ;; append k bytes of the float scratch, little-endian as stored
  (func $fbytes! (param $v i32) (param $k i32)
    ($let (($i (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $k))
        (call $byte! (local.get $v) (i32.load8_u (i32.add (i32.const 65528) (local.get $i))))
        ($inc! $i 1))))

  ;; the (type $t) reference inside a func, or 0
  (func $func-type-ref (param $f i32) (result i32)
    ($let (($p ($cdr (local.get $f))))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($when ($and (call $his ($car (local.get $p)) "type") ($sym? ($nth ($car (local.get $p)) 1)))
          (return ($nth ($car (local.get $p)) 1)))
        (local.set $p ($cdr (local.get $p))))
      (i32.const 0)))

  ;; --------------------------------------------------- module walks

  (func $nfields (param $mod i32) (param $p i32) (param $n i32) (result i32)
    ($let (($k (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) (local.get $p) (local.get $n))
          ($inc! $k 1)))
      (local.get $k)))

  (func $count-i32 (param $c i32) (result i32)
    ($let (($n (i32.const 0)) ($p ($cdr (local.get $c))))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($when (call $cis ($car (local.get $p)) "i32") ($inc! $n 1))
        (local.set $p ($cdr (local.get $p))))
      (local.get $n)))

  ;; signature of a func or import desc, packed params<<8|results
  (func $sig-key (param $f i32) (result i32)
    ($let (($np (i32.const 0)) ($nr (i32.const 0)) ($p ($cdr (local.get $f))) ($c (i32.const 0)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        ($when (call $his (local.get $c) "param")
          (local.set $np (i32.add (local.get $np) (call $count-i32 (local.get $c)))))
        ($when (call $his (local.get $c) "result")
          (local.set $nr (i32.add (local.get $nr) (call $count-i32 (local.get $c)))))
        (local.set $p ($cdr (local.get $p))))
      (i32.add (i32.mul (local.get $np) (i32.const 256)) (local.get $nr))))

  ;; a field's signature, or -1 if it declares no function
  (func $field-sig (param $f i32) (result i32)
    ($when (call $his (local.get $f) "import")
      (return (call $sig-key ($nth (local.get $f) 3))))
    ($when (call $his (local.get $f) "func")
      (return (call $sig-key (local.get $f))))
    (i32.const -1))

  ;; is this field's signature unseen among the fields before it?
  (func $sig-new? (param $mod i32) (param $stop i32) (param $key i32) (result i32)
    ($each-field (local.get $mod) $f
      ($when (i32.eq (local.get $f) (local.get $stop)) (return (i32.const 1)))
      ($when (i32.eq (call $field-sig (local.get $f)) (local.get $key)) (return (i32.const 0))))
    (i32.const 1))

  (func $sig-index (param $mod i32) (param $key i32) (result i32)
    ($let (($idx (i32.const 0)) ($k (i32.const 0)))
      ($each-field (local.get $mod) $f
        (local.set $k (call $field-sig (local.get $f)))
        ($when (i32.ne (local.get $k) (i32.const -1))
          ($when (i32.eq (local.get $k) (local.get $key)) (return (local.get $idx)))
          ($when (call $sig-new? (local.get $mod) (local.get $f) (local.get $k))
            ($inc! $idx 1))))
      (call $die "sig?")
      (i32.const 0)))

  (func $func-index (param $mod i32) (param $s i32) (result i32)
    ($let (($i (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "import")
          ($when (call $sym-eq ($nth ($nth (local.get $f) 3) 1) (local.get $s))
            (return (local.get $i)))
          ($inc! $i 1))
        ($when (call $his (local.get $f) "func")
          ($when ($and ($sym? ($nth (local.get $f) 1))
                       (call $sym-eq ($nth (local.get $f) 1) (local.get $s)))
            (return (local.get $i)))
          ($inc! $i 1)))
      (call $die "func?")
      (i32.const 0)))

  (func $local-idx (param $fn i32) (param $s i32) (result i32)
    ($let (($i (i32.const 0)) ($p ($cdr (local.get $fn))) ($c (i32.const 0)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        ($when (call $his (local.get $c) "param")
          ($when ($and ($sym? ($nth (local.get $c) 1))
                       (i32.eqz (call $cis ($nth (local.get $c) 1) "i32")))
            ($when (call $sym-eq ($nth (local.get $c) 1) (local.get $s)) (return (local.get $i)))
            ($inc! $i 1)))
        ($when (call $his (local.get $c) "local")
          ($when (call $sym-eq ($nth (local.get $c) 1) (local.get $s)) (return (local.get $i)))
          ($inc! $i 1))
        (local.set $p ($cdr (local.get $p))))
      (call $die "local?")
      (i32.const 0)))

  ;; labels are a chain of pair cells: (sym-or-zero . next), 0 ends it
  (func $label-depth (param $labels i32) (param $s i32) (result i32)
    ($let (($d (i32.const 0)) ($l (local.get $labels)))
      ($while (local.get $l)
        ($when ($and ($car (local.get $l)) (call $sym-eq ($car (local.get $l)) (local.get $s)))
          (return (local.get $d)))
        ($inc! $d 1)
        (local.set $l ($cdr (local.get $l))))
      (call $die "label?")
      (i32.const 0)))

  (func $inline-export (param $f i32) (result i32)
    ($let (($p ($cdr (local.get $f))))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($when (call $his ($car (local.get $p)) "export")
          (return ($nth ($car (local.get $p)) 1)))
        (local.set $p ($cdr (local.get $p))))
      (i32.const 0)))

  ;; ------------------------------------------------------- emitters

  (func $emit-instr (param $v i32) (param $c i32) (param $labels i32) (param $fn i32) (param $mod i32)
    ($let (($h (i32.const 0)) ($k (i32.const 0)) ($cls (i32.const 0))
           ($p (i32.const 0)) ($imm (i32.const 0)) ($imm2 (i32.const 0))
           ($rt1 (i32.const 0)) ($rt2 (i32.const 0)))
      ($unless ($pair? (local.get $c)) (call $die "instr?"))
      (local.set $h ($car (local.get $c)))
      ($when (call $cis (local.get $h) "block")
        (call $emit-block (local.get $v) (local.get $c) (local.get $labels)
                          (local.get $fn) (local.get $mod) (i32.const 2))
        (return))
      ($when (call $cis (local.get $h) "loop")
        (call $emit-block (local.get $v) (local.get $c) (local.get $labels)
                          (local.get $fn) (local.get $mod) (i32.const 3))
        (return))
      ($when (call $cis (local.get $h) "if")
        (call $emit-if (local.get $v) (local.get $c) (local.get $labels)
                       (local.get $fn) (local.get $mod))
        (return))
      (local.set $k (call $op-code ($a (local.get $h)) ($b (local.get $h))))
      (local.set $cls (i32.shr_u (local.get $k) (i32.const 8)))
      (local.set $k (i32.and (local.get $k) (i32.const 255)))
      (local.set $p ($cdr (local.get $c)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (if ($pair? ($car (local.get $p)))
          (then
            (if (call $his ($car (local.get $p)) "ref")
              (then
                (if (local.get $rt1)
                  (then (local.set $rt2 ($car (local.get $p))))
                  (else (local.set $rt1 ($car (local.get $p))))))
              (else (call $emit-instr (local.get $v) ($car (local.get $p)) (local.get $labels)
                                      (local.get $fn) (local.get $mod)))))
          (else
            (if (local.get $imm)
              (then ($when (i32.eqz (local.get $imm2))
                      (local.set $imm2 ($car (local.get $p)))))
              (else (local.set $imm ($car (local.get $p)))))))
        (local.set $p ($cdr (local.get $p))))
      ($when (i32.eq (local.get $cls) (i32.const 0))
        (call $byte! (local.get $v) (local.get $k)))
      ($when (i32.eq (local.get $cls) (i32.const 1))
        (call $byte! (local.get $v) (i32.const 65))
        (call $sleb! (local.get $v) ($a (local.get $imm))))
      ($when (i32.eq (local.get $cls) (i32.const 2))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (call $local-idx (local.get $fn) (local.get $imm))))
      ($when (i32.eq (local.get $cls) (i32.const 3))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (call $func-index (local.get $mod) (local.get $imm))))
      ($when (i32.eq (local.get $cls) (i32.const 4))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (call $label-depth (local.get $labels) (local.get $imm))))
      ($when (i32.eq (local.get $cls) (i32.const 5))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (i32.const 2))
        (call $uleb! (local.get $v) (i32.const 0)))
      ($when (i32.eq (local.get $cls) (i32.const 6))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (i32.const 0))
        (call $uleb! (local.get $v) (i32.const 0)))
      ($when (i32.eq (local.get $cls) (i32.const 7))
        (call $byte! (local.get $v) (local.get $k))
        (call $byte! (local.get $v) (i32.const 0)))
      ($when (i32.eq (local.get $cls) (i32.const 8))
        (call $byte! (local.get $v) (i32.const 252))
        (call $uleb! (local.get $v) (i32.const 10))
        (call $byte! (local.get $v) (i32.const 0))
        (call $byte! (local.get $v) (i32.const 0)))
      ($when (i32.eq (local.get $cls) (i32.const 9))
        (call $byte! (local.get $v) (i32.const 252))
        (call $uleb! (local.get $v) (i32.const 11))
        (call $byte! (local.get $v) (i32.const 0)))
      ($when (i32.eq (local.get $cls) (i32.const 10))
        (call $byte! (local.get $v) (i32.const 251))
        (call $uleb! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (call $type-index (local.get $mod) (local.get $imm))))
      ($when (i32.eq (local.get $cls) (i32.const 11))
        (call $byte! (local.get $v) (i32.const 251))
        (call $uleb! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (call $type-index (local.get $mod) (local.get $imm)))
        (call $uleb! (local.get $v) ($a (local.get $imm2))))
      ($when (i32.eq (local.get $cls) (i32.const 12))
        (call $byte! (local.get $v) (i32.const 251))
        (call $uleb! (local.get $v) (i32.add (local.get $k) (call $rtnull? (local.get $rt1))))
        (call $heaptype! (local.get $v) (call $rtty (local.get $rt1)) (local.get $mod)))
      ($when (i32.eq (local.get $cls) (i32.const 13))
        (call $byte! (local.get $v) (i32.const 251))
        (call $uleb! (local.get $v) (i32.const 24))
        (call $byte! (local.get $v)
          (i32.or (call $rtnull? (local.get $rt1))
                  (i32.shl (call $rtnull? (local.get $rt2)) (i32.const 1))))
        (call $uleb! (local.get $v) (call $label-depth (local.get $labels) (local.get $imm)))
        (call $heaptype! (local.get $v) (call $rtty (local.get $rt1)) (local.get $mod))
        (call $heaptype! (local.get $v) (call $rtty (local.get $rt2)) (local.get $mod)))
      ($when (i32.eq (local.get $cls) (i32.const 14))
        (call $byte! (local.get $v) (i32.const 251))
        (call $uleb! (local.get $v) (local.get $k)))
      ($when (i32.eq (local.get $cls) (i32.const 15))
        (call $byte! (local.get $v) (i32.const 208))
        (call $heaptype! (local.get $v) (local.get $imm) (local.get $mod)))
      ($when (i32.eq (local.get $cls) (i32.const 16))
        (if ($num? (local.get $imm))
          (then (f64.store (i32.const 65528) (f64.convert_i32_s ($a (local.get $imm)))))
          (else (call $fparse ($a (local.get $imm)) ($b (local.get $imm)))))
        (call $byte! (local.get $v) (i32.const 68))
        (call $fbytes! (local.get $v) (i32.const 8)))
      ($when (i32.eq (local.get $cls) (i32.const 17))
        (if ($num? (local.get $imm))
          (then (f64.store (i32.const 65528) (f64.convert_i32_s ($a (local.get $imm)))))
          (else (call $fparse ($a (local.get $imm)) ($b (local.get $imm)))))
        (f32.store (i32.const 65528) (f32.demote_f64 (f64.load (i32.const 65528))))
        (call $byte! (local.get $v) (i32.const 67))
        (call $fbytes! (local.get $v) (i32.const 4)))
      ($when (i32.eq (local.get $cls) (i32.const 18))
        (call $byte! (local.get $v) (local.get $k))
        (call $uleb! (local.get $v) (i32.const 3))
