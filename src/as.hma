          ($while (i32.eqz ($nil? (local.get $p)))
            (local.set $c ($car (local.get $p)))
            ($when ($pair? (local.get $c))
              ($unless ($or (call $his (local.get $c) "param")
                            ($or (call $his (local.get $c) "result")
                                 ($or (call $his (local.get $c) "local")
                                      ($or (call $his (local.get $c) "export")
                                           (call $his (local.get $c) "type")))))
