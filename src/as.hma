          (call $uleb! (local.get $v) ($vl (local.get $b)))
          (call $bytes! (local.get $v) ($vp (local.get $b)) ($vl (local.get $b)))))
      (local.get $v)))

  (func $data-sec (param $mod i32) (result i32)
    ($let (($n (call $nfields (local.get $mod) "data")) ($v (i32.const 0)) ($s (i32.const 0)))
      ($when (i32.eqz (local.get $n)) (return (i32.const 0)))
