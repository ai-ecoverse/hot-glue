;; expand-gc.hma — the Hot Glue expander, re-founded on the GC heap.
;;
;; Same contract as expand.hma, byte for byte: Hot Glue source on
;; stdin, expanded WAT on stdout. But the node algebra now lives as
;; the § 2 structs of docs/wasm-macros.md — an abstract $node with
;; subtypes for numbers, symbols, strings, pairs, and nil — and the
;; meta-Lisp's closures, builtins, and macros are $node citizens too.
;; Mark sets are pair chains; mutable state lives in GC boxes; only
;; bytes (input, output, names) remain in linear memory, because WASI
;; speaks buffers and strings are bytes wherever they live.
;;
;; It stays inside the subset as.hma assembles, so the loop holds:
;;
;;   npx tsx src/hotglue/cli.ts src/hotglue/prelude.hma src/hotglue/expand-gc.hma > expand-gc.wat
;;   cat src/hotglue/prelude.hma src/hotglue/expand-gc.hma | wasmtime -W gc,function-references expand-gc.wat > again.wat
;;   diff expand-gc.wat again.wat   ;; nothing
;;
;; Memory: 0 iovec, 8 io-count, 12 heap pointer, 20 cursor, 24 input
;; base, 28 input length, 65540 mark counter, 65548 pool offset.

(module
  (rec
    (type $node (sub (struct)))
    (type $num (sub final $node (struct (field i32))))
    (type $sym (sub final $node (struct (field i32) (field i32) (field (ref $node)))))
    (type $str (sub final $node (struct (field i32) (field i32))))
    (type $pair (sub final $node (struct (field (mut (ref $node))) (field (mut (ref $node))))))
    (type $nil (sub final $node (struct)))
    (type $clo (sub final $node (struct (field (ref $node)) (field (ref $node)) (field (ref $node)))))
    (type $bi (sub final $node (struct (field i32))))
    (type $mac (sub final $node (struct (field (ref $node)) (field (ref $node)))))
    (type $box (struct (field (mut (ref $node))))))

  (type $q-v (func))
  (type $q-i-i (func (param i32) (result i32)))
  (type $q-ii-v (func (param i32 i32)))
  (type $q-iii-v (func (param i32 i32 i32)))
  (type $q-ii-i (func (param i32 i32) (result i32)))
  (type $q-iiii-i (func (param i32 i32 i32 i32) (result i32)))
  (type $q-i-n (func (param i32) (result (ref $node))))
  (type $q-ii-n (func (param i32 i32) (result (ref $node))))
  (type $q-n (func (result (ref $node))))
  (type $q-n-i (func (param (ref $node)) (result i32)))
  (type $q-n-n (func (param (ref $node)) (result (ref $node))))
  (type $q-ni-n (func (param (ref $node) i32) (result (ref $node))))
  (type $q-nn-i (func (param (ref $node) (ref $node)) (result i32)))
  (type $q-nii-i (func (param (ref $node) i32 i32) (result i32)))
  (type $q-nn-n (func (param (ref $node) (ref $node)) (result (ref $node))))
  (type $q-nnn-n (func (param (ref $node) (ref $node) (ref $node)) (result (ref $node))))
  (type $q-nb-n (func (param (ref $node) (ref $box)) (result (ref $node))))
  (type $q-b (func (result (ref $box))))
  (type $q-bii-i (func (param (ref $box) i32 i32) (result i32)))
  (type $q-bn-v (func (param (ref $box) (ref $node))))
  (type $q-bii-n (func (param (ref $box) i32 i32) (result (ref $node))))
  (type $q-nbb-nq (func (param (ref $node) (ref $box) (ref $box)) (result (ref null $node))))
  (type $q-nbb-n (func (param (ref $node) (ref $box) (ref $box)) (result (ref $node))))
  (type $q-nnbbb-n (func (param (ref $node) (ref $node) (ref $box) (ref $box) (ref $box)) (result (ref $node))))
  (type $q-in-v (func (param i32 (ref $node))))
  (type $q-ini-v (func (param i32 (ref $node) i32)))

  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (type $q-iiii-i)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (type $q-iiii-i)))
  (memory (export "memory") 256)

  ;; ---------------------------------------------------------- sugar

  (defmacro $nil! () `(struct.new $nil))
  (defmacro $pair? (c) `(ref.test (ref $pair) ,c))
  (defmacro $sym? (c) `(ref.test (ref $sym) ,c))
  (defmacro $num? (c) `(ref.test (ref $num) ,c))
  (defmacro $str? (c) `(ref.test (ref $str) ,c))
  (defmacro $nil? (c) `(ref.test (ref $nil) ,c))
  (defmacro $atom? (c) `($or ($num? ,c) ($or ($sym? ,c) ($str? ,c))))
  (defmacro $cons (a b) `(struct.new $pair ,a ,b))
  (defmacro $car (c) `(struct.get $pair 0 (ref.cast (ref $pair) ,c)))
  (defmacro $cdr (c) `(struct.get $pair 1 (ref.cast (ref $pair) ,c)))
  (defmacro $setb! (c x) `(struct.set $pair 1 (ref.cast (ref $pair) ,c) ,x))
  (defmacro $numv (c) `(struct.get $num 0 (ref.cast (ref $num) ,c)))
  (defmacro $symp (c) `(struct.get $sym 0 (ref.cast (ref $sym) ,c)))
  (defmacro $syml (c) `(struct.get $sym 1 (ref.cast (ref $sym) ,c)))
  (defmacro $symm (c) `(struct.get $sym 2 (ref.cast (ref $sym) ,c)))
  (defmacro $strp (c) `(struct.get $str 0 (ref.cast (ref $str) ,c)))
  (defmacro $strl (c) `(struct.get $str 1 (ref.cast (ref $str) ,c)))
  (defmacro $bxa (b) `(struct.get $box 0 ,b))
  (defmacro $bxa! (b x) `(struct.set $box 0 ,b ,x))

  (defmacro $nth (c k)
    (if (= k 0) `($car ,c) `($nth ($cdr ,c) ,(- k 1))))

  (defmacro $vp (v) `(i32.load ,v))
  (defmacro $vl (v) `(i32.load (i32.add ,v (i32.const 4))))
  (defmacro $vc (v) `(i32.load (i32.add ,v (i32.const 8))))
  (defmacro $vl! (v x) `(i32.store (i32.add ,v (i32.const 4)) ,x))

  (defmacro $pos () `(i32.load (i32.const 20)))
  (defmacro $pos! (x) `(i32.store (i32.const 20) ,x))
  (defmacro $adv () `($pos! (i32.add ($pos) (i32.const 1))))
  (defmacro $inbase () `(i32.load (i32.const 24)))
  (defmacro $inlen () `(i32.load (i32.const 28)))
  (defmacro $byte () `(i32.load8_u (i32.add ($inbase) ($pos))))

  (defmacro $mark () `(i32.load (i32.const 65540)))
  (defmacro $mark! (x) `(i32.store (i32.const 65540) ,x))
  (defmacro $pooloff () `(i32.load (i32.const 65548)))
  (defmacro $pooloff! (x) `(i32.store (i32.const 65548) ,x))

  ;; Append x to the list built in locals h (ref $node) and t (nullable).
  (defmacro $append! (h t x)
    `($let (($q (ref $node) ($cons ,x ($nil!))))
       (if (ref.is_null (local.get ,t))
         (then (local.set ,h (local.get $q)))
         (else ($setb! (local.get ,t) (local.get $q))))
       (local.set ,t (local.get $q))))

  ;; ----------------------------------------------------------- heap

  (func $init (type $q-v)
    (i32.store (i32.const 12) (i32.const 65552))
    ($pooloff! (i32.const 32)))

  (func $alloc (type $q-i-i) (param $n i32) (result i32)
    ($let (($p (i32.load (i32.const 12))))
      (i32.store (i32.const 12)
        (i32.and (i32.add (i32.add (local.get $p) (local.get $n)) (i32.const 3)) (i32.const -4)))
      ($while (i32.gt_u (i32.load (i32.const 12)) (i32.mul (memory.size) (i32.const 65536)))
        (drop (memory.grow (i32.const 16))))
      (local.get $p)))

  (func $mknum (type $q-i-n) (param $v i32) (result (ref $node))
    (struct.new $num (local.get $v)))

  (func $mksym (type $q-ii-n) (param $p i32) (param $n i32) (result (ref $node))
    (struct.new $sym (local.get $p) (local.get $n) ($nil!)))

  (func $mkstr (type $q-ii-n) (param $p i32) (param $n i32) (result (ref $node))
    (struct.new $str (local.get $p) (local.get $n)))

  (func $list1 (type $q-n-n) (param $x (ref $node)) (result (ref $node))
    ($cons (local.get $x) ($nil!)))

  (func $list2 (type $q-nn-n) (param $x (ref $node)) (param $y (ref $node)) (result (ref $node))
    ($cons (local.get $x) (call $list1 (local.get $y))))

  (func $box (type $q-b) (result (ref $box))
    (struct.new $box ($nil!)))

  ;; -------------------------------------------------------- strings

  (func $str-eq (type $q-iiii-i) (param $ap i32) (param $al i32) (param $bp i32) (param $bl i32) (result i32)
    ($let (($i (i32.const 0)))
      ($when (i32.ne (local.get $al) (local.get $bl)) (return (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $al))
        ($when (i32.ne (i32.load8_u (i32.add (local.get $ap) (local.get $i)))
                       (i32.load8_u (i32.add (local.get $bp) (local.get $i))))
          (return (i32.const 0)))
        ($inc! $i 1))
      (i32.const 1)))

  (func $cis (type $q-nii-i) (param $c (ref $node)) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($sym? (local.get $c))) (return (i32.const 0)))
    (call $str-eq ($symp (local.get $c)) ($syml (local.get $c)) (local.get $p) (local.get $n)))

  (func $his (type $q-nii-i) (param $c (ref $node)) (param $p i32) (param $n i32) (result i32)
    ($when (i32.eqz ($pair? (local.get $c))) (return (i32.const 0)))
    (call $cis ($car (local.get $c)) (local.get $p) (local.get $n)))

  ;; ------------------------------------------------------ mark sets

  ;; sorted pair chains of $num, nil-terminated; the flip toggles
  (func $mstog (type $q-ni-n) (param $s (ref $node)) (param $m i32) (result (ref $node))
    ($when ($nil? (local.get $s))
      (return ($cons (call $mknum (local.get $m)) ($nil!))))
    ($when (i32.eq ($numv ($car (local.get $s))) (local.get $m))
      (return ($cdr (local.get $s))))
    ($when (i32.gt_u ($numv ($car (local.get $s))) (local.get $m))
      (return ($cons (call $mknum (local.get $m)) (local.get $s))))
    ($cons ($car (local.get $s)) (call $mstog ($cdr (local.get $s)) (local.get $m))))

  (func $mseq (type $q-nn-i) (param $x (ref $node)) (param $y (ref $node)) (result i32)
    ($while ($and (i32.eqz ($nil? (local.get $x))) (i32.eqz ($nil? (local.get $y))))
      ($when (i32.ne ($numv ($car (local.get $x))) ($numv ($car (local.get $y))))
        (return (i32.const 0)))
      (local.set $x ($cdr (local.get $x)))
      (local.set $y ($cdr (local.get $y))))
    ($and ($nil? (local.get $x)) ($nil? (local.get $y))))

  (func $keyeq (type $q-nn-i) (param $x (ref $node)) (param $y (ref $node)) (result i32)
    ($and (call $str-eq ($symp (local.get $x)) ($syml (local.get $x))
                        ($symp (local.get $y)) ($syml (local.get $y)))
          (call $mseq ($symm (local.get $x)) ($symm (local.get $y)))))

  ;; ----------------------------------------------------------- vecs

  (func $vec-new (type $q-i-i) (param $cap i32) (result i32)
    ($let (($v (call $alloc (i32.const 12))))
      (i32.store (local.get $v) (call $alloc (local.get $cap)))
      (i32.store (i32.add (local.get $v) (i32.const 4)) (i32.const 0))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))
      (local.get $v)))

  (func $vec-room (type $q-ii-v) (param $v i32) (param $n i32)
    ($let (($need (i32.add ($vl (local.get $v)) (local.get $n)))
           ($cap ($vc (local.get $v)))
           ($np (i32.const 0)))
      ($when (i32.le_u (local.get $need) (local.get $cap)) (return))
      ($while (i32.lt_u (local.get $cap) (local.get $need))
        (local.set $cap (i32.mul (local.get $cap) (i32.const 2))))
      (local.set $np (call $alloc (local.get $cap)))
      (memory.copy (local.get $np) ($vp (local.get $v)) ($vl (local.get $v)))
      (i32.store (local.get $v) (local.get $np))
      (i32.store (i32.add (local.get $v) (i32.const 8)) (local.get $cap))))

  (func $byte! (type $q-ii-v) (param $v i32) (param $x i32)
    (call $vec-room (local.get $v) (i32.const 1))
    (i32.store8 (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $x))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.const 1))))

  (func $bytes! (type $q-iii-v) (param $v i32) (param $p i32) (param $n i32)
    (call $vec-room (local.get $v) (local.get $n))
    (memory.copy (i32.add ($vp (local.get $v)) ($vl (local.get $v))) (local.get $p) (local.get $n))
    ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (local.get $n))))

  ;; ------------------------------------------------------------- io

  (func $die (type $q-ii-v) (param $p i32) (param $n i32)
    (i32.store (i32.const 0) (local.get $p))
    (i32.store (i32.const 4) (local.get $n))
    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))
    (unreachable))

  (func $read-all (type $q-v)
    ($let (($v (call $vec-new (i32.const 65536))))
      (block $done
        (loop $more
          (call $vec-room (local.get $v) (i32.const 65536))
          (i32.store (i32.const 0) (i32.add ($vp (local.get $v)) ($vl (local.get $v))))
          (i32.store (i32.const 4) (i32.sub ($vc (local.get $v)) ($vl (local.get $v))))
          ($when (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8))
            (call $die "read"))
          (br_if $done (i32.eqz (i32.load (i32.const 8))))
          ($vl! (local.get $v) (i32.add ($vl (local.get $v)) (i32.load (i32.const 8))))
          (br $more)))
      (i32.store (i32.const 24) ($vp (local.get $v)))
      (i32.store (i32.const 28) ($vl (local.get $v)))
      (i32.store (i32.const 20) (i32.const 0))))

  (func $write-all (type $q-ii-v) (param $p i32) (param $n i32)
    ($while (i32.gt_u (local.get $n) (i32.const 0))
      (i32.store (i32.const 0) (local.get $p))
      (i32.store (i32.const 4) (local.get $n))
      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
      ($when (i32.eqz (i32.load (i32.const 8))) (call $die "write"))
      (local.set $p (i32.add (local.get $p) (i32.load (i32.const 8))))
      (local.set $n (i32.sub (local.get $n) (i32.load (i32.const 8))))))

  ;; --------------------------------------------------------- reader

  (func $digit? (type $q-i-i) (param $b i32) (result i32)
    ($and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57))))

  (func $symch? (type $q-i-i) (param $b i32) (result i32)
    ($when (i32.le_u (local.get $b) (i32.const 32)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 40)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 41)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 91)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 93)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 59)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 34)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 39)) (return (i32.const 0)))
    ($when (i32.eq (local.get $b) (i32.const 96)) (return (i32.const 0)))
    (i32.ne (local.get $b) (i32.const 44)))

  (func $hex (type $q-i-i) (param $b i32) (result i32)
    (if (result i32) (i32.le_u (local.get $b) (i32.const 57))
      (then (i32.sub (local.get $b) (i32.const 48)))
      (else (i32.sub (local.get $b) (i32.const 87)))))

  (func $skip (type $q-v)
    (block $out
      (loop $again
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.le_u ($byte) (i32.const 32)))
          ($adv))
        (br_if $out (i32.ge_u (i32.add ($pos) (i32.const 1)) ($inlen)))
        ($when ($and (i32.eq ($byte) (i32.const 59))
                     (i32.eq (i32.load8_u (i32.add (i32.add ($inbase) ($pos)) (i32.const 1))) (i32.const 59)))
          ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 10)))
            ($adv))
          (br $again)))))

  (func $parse (type $q-n) (result (ref $node))
    ($let (($h (ref $node) ($nil!)) ($t (ref null $node) (ref.null none))
           ($n (i32.const 0)) ($s (i32.const 0)) ($v (i32.const 0))
           ($neg (i32.const 0)) ($num (i32.const 1)) ($i (i32.const 0)))
      (call $skip)
      ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
      ($when (i32.eq ($byte) (i32.const 40))
        ($adv)
        (call $skip)
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 41)))
          ($append! $h $t (call $parse))
          (call $skip))
        ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
        ($adv)
        (return (local.get $h)))
      ($when (i32.eq ($byte) (i32.const 41)) (call $die "stray"))
      ($when (i32.eq ($byte) (i32.const 91))
        ($adv)
        (call $skip)
        ($while ($and (i32.lt_u ($pos) ($inlen)) (i32.ne ($byte) (i32.const 93)))
          ($append! $h $t (call $parse))
          (call $skip))
        ($when (i32.ge_u ($pos) ($inlen)) (call $die "eof"))
        ($adv)
        (return (local.get $h)))
      ($when (i32.eq ($byte) (i32.const 93)) (call $die "stray"))
      ($when (i32.eq ($byte) (i32.const 96))
        ($adv)
        (return (call $list2 (call $mksym "quasiquote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 44))
        ($adv)
        ($when (i32.eq ($byte) (i32.const 64))
          ($adv)
          (return (call $list2 (call $mksym "unquote-splicing") (call $parse))))
        (return (call $list2 (call $mksym "unquote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 39))
        ($adv)
        (return (call $list2 (call $mksym "quote") (call $parse))))
      ($when (i32.eq ($byte) (i32.const 34))
        ($adv)
        (local.set $v (call $vec-new (i32.const 16)))
        ($while (i32.ne ($byte) (i32.const 34))
          ($when (i32.ge_u ($pos) ($inlen)) (call $die "string"))
          (local.set $n ($byte))
          ($adv)
          ($when (i32.eq (local.get $n) (i32.const 92))
            (local.set $n ($byte))
            ($adv)
            (local.set $n
              ($cond
                ((i32.eq (local.get $n) (i32.const 110)) (i32.const 10))
                ((i32.eq (local.get $n) (i32.const 116)) (i32.const 9))
                ((i32.eq (local.get $n) (i32.const 34)) (i32.const 34))
                ((i32.eq (local.get $n) (i32.const 92)) (i32.const 92))
                (else (call $die "escape") (i32.const 0)))))
          (call $byte! (local.get $v) (local.get $n)))
        ($adv)
        (return (call $mkstr ($vp (local.get $v)) ($vl (local.get $v)))))
      (local.set $s ($pos))
      ($while ($and (i32.lt_u ($pos) ($inlen)) (call $symch? ($byte)))
        ($adv))
      ($when (i32.eq ($pos) (local.get $s)) (call $die "token"))
      (local.set $i (local.get $s))
      (local.set $neg (i32.eq (i32.load8_u (i32.add ($inbase) (local.get $s))) (i32.const 45)))
      ($when (local.get $neg) (local.set $i (i32.add (local.get $i) (i32.const 1))))
      ($when (i32.ge_u (local.get $i) ($pos)) (local.set $num (i32.const 0)))
      ($let (($j (local.get $i)))
        ($while (i32.lt_u (local.get $j) ($pos))
          ($unless (call $digit? (i32.load8_u (i32.add ($inbase) (local.get $j))))
            (local.set $num (i32.const 0)))
          ($inc! $j 1)))
      ($when (local.get $num)
        (local.set $n (i32.const 0))
        ($while (i32.lt_u (local.get $i) ($pos))
          (local.set $n (i32.add (i32.mul (local.get $n) (i32.const 10))
                                 (i32.sub (i32.load8_u (i32.add ($inbase) (local.get $i))) (i32.const 48))))
          ($inc! $i 1))
        ($when (local.get $neg) (local.set $n (i32.sub (i32.const 0) (local.get $n))))
        (return (call $mknum (local.get $n))))
      (call $mksym (i32.add ($inbase) (local.get $s)) (i32.sub ($pos) (local.get $s)))))

  ;; -------------------------------------------------- the meta-Lisp

  ;; environments: chains of pair(pair(sym . val) . next), nil-ended
  (func $bind (type $q-nnn-n) (param $env (ref $node)) (param $s (ref $node)) (param $v (ref $node)) (result (ref $node))
    ($cons ($cons (local.get $s) (local.get $v)) (local.get $env)))

  (func $builtin-id (type $q-ii-i) (param $p i32) (param $n i32) (result i32)
    ($ops (local.get $p) (local.get $n)
      (0 "first" 1)
      (0 "second" 2)
      (0 "rest" 3)
      (0 "length" 4)
      (0 "map" 5)
      (0 "=" 6)
      (0 "+" 7)
      (0 "-" 8)
      (0 "*" 9)
      (0 "sym-is?" 10)
      (0 "list?" 11)
      (0 "sym?" 12))
    (i32.const 0))

