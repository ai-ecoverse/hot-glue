        (return (local.get $h)))
      ($append! $h $t (local.get $hd))
      (local.set $scope (local.get $labels))
      (local.set $p ($cdr (local.get $n)))
      ($when ($and (call $labeled? (local.get $hd))
                   ($and (i32.eqz ($nil? (local.get $p))) ($sym? ($car (local.get $p)))))
        (local.set $x ($car (local.get $p)))
        (local.set $pr (call $freshname (local.get $pb) ($symp (local.get $x)) ($syml (local.get $x))))
        (local.set $scope ($cons ($cons (local.get $x) (local.get $pr)) (local.get $labels)))
        ($append! $h $t (call $mksym ($strp (local.get $pr)) ($strl (local.get $pr))))
        (local.set $p ($cdr (local.get $p))))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $x ($car (local.get $p)))
        (if ($str? (local.get $x))
          (then
            (local.set $e (call $intern (local.get $x) (local.get $pool)))
            ($append! $h $t (call $list2 (call $mksym "i32.const") ($cdr (local.get $e))))
            ($append! $h $t (call $list2 (call $mksym "i32.const") (call $mknum ($strl (local.get $x))))))
          (else ($append! $h $t (call $walkc (local.get $x) (local.get $scope)
                                      (local.get $vars) (local.get $pb) (local.get $pool)))))
        (local.set $p ($cdr (local.get $p))))
      (local.get $h)))

  (func $lower-func (type $q-nb-n) (param $f (ref $node)) (param $pool (ref $box)) (result (ref $node))
    ($let (($names-h (ref $node) ($nil!)) ($names-t (ref null $node) (ref.null none))
           ($sig-h (ref $node) ($nil!)) ($sig-t (ref null $node) (ref.null none))
           ($code-h (ref $node) ($nil!)) ($code-t (ref null $node) (ref.null none))
           ($seen (ref $box) (call $box)) ($lb (ref $box) (call $box))
           ($pb (ref $box) (call $box)) ($vars (ref $box) (call $box))
           ($p (ref $node) ($nil!)) ($c (ref $node) ($nil!))
           ($x (ref null $node) (ref.null none))
           ($h (ref $node) ($nil!)) ($t (ref null $node) (ref.null none))
           ($locs (ref $node) ($nil!)))
      (local.set $p ($cdr (local.get $f)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        (if ($and ($sym? (local.get $c))
                  ($and ($nil? (local.get $sig-h)) ($nil? (local.get $code-h))))
          (then ($append! $names-h $names-t (local.get $c)))
          (else
            (if ($and ($pair? (local.get $c)) (call $sig-head? ($car (local.get $c))))
              (then ($append! $sig-h $sig-t (local.get $c)))
              (else
                (local.set $x (call $sweep (local.get $c) (local.get $seen) (local.get $lb)))
                ($unless (ref.is_null (local.get $x))
                  ($append! $code-h $code-t (ref.as_non_null (local.get $x))))))))
        (local.set $p ($cdr (local.get $p))))
      ;; collected locals are newest-first; restore source order
      (local.set $p ($bxa (local.get $lb)))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $locs ($cons ($car (local.get $p)) (local.get $locs)))
        (local.set $p ($cdr (local.get $p))))
      ;; rebuild: head, names, declared sig, declared locals, walked code
      ($append! $h $t ($car (local.get $f)))
      (local.set $p (local.get $names-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $h $t ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $sig-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        (if (call $his ($car (local.get $p)) "param")
          (then ($append! $h $t (call $declare ($car (local.get $p)) (local.get $vars) (local.get $pb))))
          (else ($append! $h $t ($car (local.get $p)))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $locs))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $h $t (call $declare ($car (local.get $p)) (local.get $vars) (local.get $pb)))
        (local.set $p ($cdr (local.get $p))))
      (local.set $p (local.get $code-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($append! $h $t (call $walkc ($car (local.get $p)) ($nil!)
                              (local.get $vars) (local.get $pb) (local.get $pool)))
        (local.set $p ($cdr (local.get $p))))
      (local.get $h)))

  (func $lower-mod (type $q-n-n) (param $m (ref $node)) (result (ref $node))
    ($let (($h (ref $node) ($nil!)) ($t (ref null $node) (ref.null none))
           ($p (ref $node) ($nil!)) ($c (ref $node) ($nil!)) ($e (ref $node) ($nil!))
           ($pool (ref $box) (call $box)))
      ($pooloff! (i32.const 32))
      (local.set $p (local.get $m))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $c ($car (local.get $p)))
        (if (call $his (local.get $c) "func")
          (then ($append! $h $t (call $lower-func (local.get $c) (local.get $pool))))
          (else ($append! $h $t (local.get $c))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $e ($bxa (local.get $pool)))
      ($while (i32.eqz ($nil? (local.get $e)))
        ($append! $h $t
          ($cons (call $mksym "data")
            (call $list2
              (call $list2 (call $mksym "i32.const") ($cdr ($car (local.get $e))))
              ($car ($car (local.get $e))))))
        (local.set $e ($cdr (local.get $e))))
      (local.get $h)))

  ;; ------------------------------------------------------ the printer

  (func $itoa! (type $q-ii-v) (param $v i32) (param $x i32)
    ($when (i32.lt_s (local.get $x) (i32.const 0))
      (call $byte! (local.get $v) (i32.const 45))
      (local.set $x (i32.sub (i32.const 0) (local.get $x))))
    ($when (i32.ge_u (local.get $x) (i32.const 10))
      (call $itoa-r! (local.get $v) (i32.div_u (local.get $x) (i32.const 10))))
    (call $byte! (local.get $v) (i32.add (i32.const 48) (i32.rem_u (local.get $x) (i32.const 10)))))

  (func $itoa-r! (type $q-ii-v) (param $v i32) (param $x i32)
    ($when (i32.ge_u (local.get $x) (i32.const 10))
      (call $itoa-r! (local.get $v) (i32.div_u (local.get $x) (i32.const 10))))
    (call $byte! (local.get $v) (i32.add (i32.const 48) (i32.rem_u (local.get $x) (i32.const 10)))))

  (func $hexdigit (type $q-i-i) (param $d i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $d) (i32.const 10))
      (then (i32.add (local.get $d) (i32.const 48)))
      (else (i32.add (local.get $d) (i32.const 87)))))

  (func $esc! (type $q-iii-v) (param $v i32) (param $p i32) (param $n i32)
    ($let (($i (i32.const 0)) ($b (i32.const 0)))
      ($while (i32.lt_u (local.get $i) (local.get $n))
        (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        ($cond
          ((i32.eq (local.get $b) (i32.const 34))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 34))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 92))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 10))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 110))
           (i32.const 0))
          ((i32.eq (local.get $b) (i32.const 9))
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (i32.const 116))
           (i32.const 0))
          (($and (i32.ge_u (local.get $b) (i32.const 32)) (i32.lt_u (local.get $b) (i32.const 127)))
           (call $byte! (local.get $v) (local.get $b))
           (i32.const 0))
          (else
           (call $byte! (local.get $v) (i32.const 92))
           (call $byte! (local.get $v) (call $hexdigit (i32.shr_u (local.get $b) (i32.const 4))))
           (call $byte! (local.get $v) (call $hexdigit (i32.and (local.get $b) (i32.const 15))))
           (i32.const 0)))
        (drop)
        ($inc! $i 1))))

  (func $print-flat (type $q-in-v) (param $v i32) (param $n (ref $node))
    ($let (($p (ref $node) ($nil!)) ($first (i32.const 1)))
      ($when ($sym? (local.get $n))
        (call $bytes! (local.get $v) ($symp (local.get $n)) ($syml (local.get $n)))
        (return))
      ($when ($num? (local.get $n))
        (call $itoa! (local.get $v) ($numv (local.get $n)))
        (return))
      ($when ($str? (local.get $n))
        (call $byte! (local.get $v) (i32.const 34))
        (call $esc! (local.get $v) ($strp (local.get $n)) ($strl (local.get $n)))
        (call $byte! (local.get $v) (i32.const 34))
        (return))
      (call $byte! (local.get $v) (i32.const 40))
      (local.set $p (local.get $n))
      ($while ($pair? (local.get $p))
        ($unless (local.get $first) (call $byte! (local.get $v) (i32.const 32)))
        (local.set $first (i32.const 0))
        (call $print-flat (local.get $v) ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 41))))

  (func $print (type $q-ini-v) (param $v i32) (param $n (ref $node)) (param $d i32)
    ($let (($fv (i32.const 0)) ($p (ref $node) ($nil!)) ($j (i32.const 0)))
      ($unless ($pair? (local.get $n))
        (call $print-flat (local.get $v) (local.get $n))
        (return))
      (local.set $fv (call $vec-new (i32.const 64)))
      (call $print-flat (local.get $fv) (local.get $n))
      ($when (i32.le_u (i32.add (i32.mul (local.get $d) (i32.const 2)) ($vl (local.get $fv)))
                       (i32.const 100))
        (call $bytes! (local.get $v) ($vp (local.get $fv)) ($vl (local.get $fv)))
        (return))
      (call $byte! (local.get $v) (i32.const 40))
      (call $print (local.get $v) ($car (local.get $n)) (local.get $d))
      (local.set $p ($cdr (local.get $n)))
      ($while ($and ($pair? (local.get $p)) ($atom? ($car (local.get $p))))
        (call $byte! (local.get $v) (i32.const 32))
        (call $print-flat (local.get $v) ($car (local.get $p)))
        (local.set $p ($cdr (local.get $p))))
      ($while ($pair? (local.get $p))
        (call $byte! (local.get $v) (i32.const 10))
        (local.set $j (i32.const 0))
        ($while (i32.lt_u (local.get $j) (i32.mul (i32.add (local.get $d) (i32.const 1)) (i32.const 2)))
          (call $byte! (local.get $v) (i32.const 32))
          ($inc! $j 1))
        (call $print (local.get $v) ($car (local.get $p)) (i32.add (local.get $d) (i32.const 1)))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 41))))

  ;; ----------------------------------------------------------- main

  (func (export "_start") (type $q-v)
    ($let (($top-h (ref $node) ($nil!)) ($top-t (ref null $node) (ref.null none))
           ($out-h (ref $node) ($nil!)) ($out-t (ref null $node) (ref.null none))
           ($reg (ref $box) (call $box))
           ($p (ref $node) ($nil!)) ($x (ref $node) ($nil!)) ($g (ref $node) ($nil!))
           ($v (i32.const 0)) ($first (i32.const 1)))
      (call $init)
      (call $read-all)
      (call $skip)
      ($while (i32.lt_u ($pos) ($inlen))
        ($append! $top-h $top-t (call $parse))
        (call $skip))
      (local.set $p (local.get $top-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        (local.set $x (call $one ($car (local.get $p)) (local.get $reg)))
        (if (call $his (local.get $x) "splice")
          (then
            (local.set $x ($cdr (local.get $x)))
            ($while (i32.eqz ($nil? (local.get $x)))
              ($append! $out-h $out-t ($car (local.get $x)))
              (local.set $x ($cdr (local.get $x)))))
          (else ($append! $out-h $out-t (local.get $x))))
        (local.set $p ($cdr (local.get $p))))
      (local.set $v (call $vec-new (i32.const 65536)))
      (local.set $p (local.get $out-h))
      ($while (i32.eqz ($nil? (local.get $p)))
        ($unless (local.get $first) (call $byte! (local.get $v) (i32.const 10)))
        (local.set $first (i32.const 0))
        (local.set $g ($car (local.get $p)))
        ($when (call $his (local.get $g) "module")
          (local.set $g (call $lower-mod (local.get $g))))
        (call $print (local.get $v) (local.get $g) (i32.const 0))
        (local.set $p ($cdr (local.get $p))))
      (call $byte! (local.get $v) (i32.const 10))
      (call $write-all ($vp (local.get $v)) ($vl (local.get $v))))))
