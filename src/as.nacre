  (func $func-sec (param $mod i32) (result i32)
    ($let (($n (call $nfields (local.get $mod) "func")) ($v (i32.const 0)))
      ($when (i32.eqz (local.get $n)) (return (i32.const 0)))
      (local.set $v (call $vec-new (i32.const 64)))
      (call $uleb! (local.get $v) (local.get $n))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "func")
          (call $uleb! (local.get $v)
            (call $sig-index (local.get $mod) (call $sig-key (local.get $f))))))
      (local.get $v)))

  (func $memory-sec (param $mod i32) (result i32)
    ($let (($v (i32.const 0)) ($p (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "memory")
          (local.set $v (call $vec-new (i32.const 8)))
          (call $uleb! (local.get $v) (i32.const 1))
          (call $byte! (local.get $v) (i32.const 0))
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            ($when ($num? ($car (local.get $p)))
              (call $uleb! (local.get $v) ($a ($car (local.get $p)))))
            (local.set $p ($cdr (local.get $p))))
          (return (local.get $v))))
      (i32.const 0)))

  (func $export-sec (param $mod i32) (result i32)
    ($let (($n (i32.const 0)) ($v (i32.const 0)) ($fi (i32.const 0)) ($e (i32.const 0)))
      ($each-field (local.get $mod) $f
        ($when ($or (call $his (local.get $f) "func") (call $his (local.get $f) "memory"))
          ($when (call $inline-export (local.get $f)) ($inc! $n 1))))
      ($when (i32.eqz (local.get $n)) (return (i32.const 0)))
      (local.set $v (call $vec-new (i32.const 64)))
      (call $uleb! (local.get $v) (local.get $n))
      (local.set $fi (call $nfields (local.get $mod) "import"))
      ($each-field (local.get $mod) $g
        ($when (call $his (local.get $g) "memory")
          (local.set $e (call $inline-export (local.get $g)))
          ($when (local.get $e)
            (call $lenbytes! (local.get $v) ($a (local.get $e)) ($b (local.get $e)))
            (call $byte! (local.get $v) (i32.const 2))
            (call $uleb! (local.get $v) (i32.const 0))))
        ($when (call $his (local.get $g) "func")
          (local.set $e (call $inline-export (local.get $g)))
          ($when (local.get $e)
            (call $lenbytes! (local.get $v) ($a (local.get $e)) ($b (local.get $e)))
            (call $byte! (local.get $v) (i32.const 0))
            (call $uleb! (local.get $v) (local.get $fi)))
          ($inc! $fi 1)))
      (local.get $v)))

  (func $code-sec (param $mod i32) (result i32)
    ($let (($v (i32.const 0)) ($b (i32.const 0)) ($nl (i32.const 0))
           ($p (i32.const 0)) ($c (i32.const 0)))
      ($when (i32.eqz (call $nfields (local.get $mod) "func")) (return (i32.const 0)))
      (local.set $v (call $vec-new (i32.const 4096)))
      (call $uleb! (local.get $v) (call $nfields (local.get $mod) "func"))
      ($each-field (local.get $mod) $f
        ($when (call $his (local.get $f) "func")
          (local.set $b (call $vec-new (i32.const 512)))
          (local.set $nl (i32.const 0))
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            ($when (call $his ($car (local.get $p)) "local") ($inc! $nl 1))
            (local.set $p ($cdr (local.get $p))))
          (if (local.get $nl)
            (then (call $uleb! (local.get $b) (i32.const 1))
                  (call $uleb! (local.get $b) (local.get $nl))
                  (call $byte! (local.get $b) (i32.const 127)))
            (else (call $uleb! (local.get $b) (i32.const 0))))
          (local.set $p ($cdr (local.get $f)))
          ($while (i32.eqz ($nil? (local.get $p)))
            (local.set $c ($car (local.get $p)))
            ($when ($pair? (local.get $c))
              ($unless ($or (call $his (local.get $c) "param")
