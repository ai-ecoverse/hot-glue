    (call $uleb! (local.get $out) ($vl (local.get $v)))
    (call $bytes! (local.get $out) ($vp (local.get $v)) ($vl (local.get $v))))

  (func $assemble (param $mod i32) (result i32)
    ($let (($o (call $vec-new (i32.const 16384))))
      (call $byte! (local.get $o) (i32.const 0))
      (call $byte! (local.get $o) (i32.const 97))
      (call $byte! (local.get $o) (i32.const 115))
      (call $byte! (local.get $o) (i32.const 109))
      (call $byte! (local.get $o) (i32.const 1))
      (call $byte! (local.get $o) (i32.const 0))
      (call $byte! (local.get $o) (i32.const 0))
      (call $byte! (local.get $o) (i32.const 0))
      (call $sec! (local.get $o) (i32.const 1) (call $type-sec (local.get $mod)))
