      (call $sec! (local.get $o) (i32.const 11) (call $data-sec (local.get $mod)))
      (local.get $o)))

  (func (export "_start")
    (call $init)
    (call $read-all)
    ($let (($m (call $parse)) ($o (i32.const 0)))
      ($unless (call $his (local.get $m) "module") (call $die "module?"))
      (local.set $o (call $assemble (local.get $m)))
      (call $write-all ($vp (local.get $o)) ($vl (local.get $o))))))
